	local SND_REMOTE_LIST = { "primordial", "neverlose", "sparkle", "mc bow", "skeet", "break", "rust" }
	local SND_LOCAL_LIST = { "applepay", "bubble", "combobreak", "killcard", "xp", "na naxuy", "stony", "hentai" }
