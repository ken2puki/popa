				local t0 = os.clock()
				repeat
					task.wait()
				until an:FindFirstChild("idle") or os.clock() - t0 > 5
				pcall(S.ApplyPack, name)
			end)
		end))

		S._RefreshPackList = function()
			S.PackFavs = S.PackFavs or {}
			local q = tostring(S.PackSearch or ""):lower()
			local list = S.PackCatalog
			if q ~= "" then
				local filtered = {}
				for _, e in ipairs(list) do
					if e.name:lower():find(q, 1, true) then filtered[#filtered + 1] = e end
				end
				S.PackFiltered = filtered
			else
				S.PackFiltered = list
			end

			if next(S.PackFavs) ~= nil then
				local fav, rest = {}, {}
				for _, e in ipairs(S.PackFiltered) do
					if S.PackFavs[e.name] then fav[#fav+1] = e else rest[#rest+1] = e end
				end
				for _, e in ipairs(rest) do fav[#fav+1] = e end
				S.PackFiltered = fav
			end
			local total = #S.PackFiltered
			S.PackTotalPages = math.max(1, math.ceil(total / S.PacksPerPage))
			if S.PackPage > S.PackTotalPages then S.PackPage = S.PackTotalPages end
			if S.PackPage < 1 then S.PackPage = 1 end
		end

		local function ingest(list)
			local seen = {}
			for _, e in ipairs(S.PackCatalog) do seen[e.id] = true end
			for _, item in pairs(list) do
				local id = tonumber(item.id)
				if id and id > 0 and item.bundledItems and not seen[id] then
					seen[id] = true
					local nm = tostring(item.name or ("Animation " .. id))
					if packByName[nm] then nm = nm .. " [" .. id .. "]" end
					packByName[nm] = { id = id, bundledItems = item.bundledItems }
					S.PackCatalog[#S.PackCatalog + 1] = { id = id, name = nm }
				end
			end
		end

		task.spawn(function()
			local cached
			pcall(function()
				if isfile and isfile(PACK_CACHE) then
					local d = game:GetService("HttpService"):JSONDecode(readfile(PACK_CACHE))
					if type(d) == "table" and #d > 0 then cached = d end
				end
			end)
			if cached then
				ingest(cached)
				table.sort(S.PackCatalog, function(a, b) return a.name < b.name end)
				S._RefreshPackList()
				if S._BuildPackGrid then pcall(S._BuildPackGrid) end
			end

			local fresh = {}
			for _, url in ipairs(CAT_URLS) do
				local ok, res = pcall(function()
