		local function loadAura(name)
			if cache[name] then return cache[name] end
			local id = AURA_ASSETS[name]
			if not id then return nil end
			local ok, objs = pcall(game.GetObjects, game, id)
			if not ok or not objs or not objs[1] then return nil end
			cache[name] = objs[1]
			return objs[1]
		end

		local function stripAura()
			base = {}
			for i = #live, 1, -1 do
				pcall(function() live[i]:Destroy() end)
				live[i] = nil
			end

			local char = LP.Character
			if char then
				for _, d in ipairs(char:GetDescendants()) do
					if d:GetAttribute("NL_Aura") then pcall(function() d:Destroy() end) end
				end
			end
		end
		S._StripAura = stripAura

		local base = {}

		local function eachEmitter(fn)
			for _, inst in ipairs(live) do
				if inst and inst.Parent then
					if inst:IsA("ParticleEmitter") then fn(inst) end
					for _, d in ipairs(inst:GetDescendants()) do
						if d:IsA("ParticleEmitter") then fn(d) end
					end
				end
			end
		end

		local function snap(pe)
			local b = base[pe]
			if not b then
				b = { spd = pe.Speed, rot = pe.RotSpeed, life = pe.Lifetime,
				      bri = pe.Brightness, le = pe.LightEmission }
				base[pe] = b
			end
			return b
		end

		local function applySpeed()
			local k = math.clamp((tonumber(S.AuraSpeed) or 100) / 100, 0.05, 5)
			eachEmitter(function(pe)
				local b = snap(pe)
				pcall(function()
					pe.Speed    = NumberRange.new(b.spd.Min * k, b.spd.Max * k)
					pe.RotSpeed = NumberRange.new(b.rot.Min * k, b.rot.Max * k)
					pe.Lifetime = NumberRange.new(
						math.max(b.life.Min / k, 0.05),
						math.max(b.life.Max / k, 0.06))
				end)
			end)
		end
		S._ApplyAuraSpeed = applySpeed

		local function applyGlow()
			local k = math.clamp((tonumber(S.AuraGlow) or 100) / 100, 0, 8)
			eachEmitter(function(pe)
				local b = snap(pe)
				pcall(function()
					pe.Brightness = math.max(b.bri, 1) * k
					pe.LightEmission = math.clamp(b.le + (k - 1) * 0.5, 0, 1)
				end)
			end)
		end
		S._ApplyAuraGlow = applyGlow

		S._ApplyAura = function()
			stripAura()
			if not S.Aura then return end
			local char = LP.Character
			if not char then return end
			local template = loadAura(S.AuraName)
			if not template then return end

			local clone = template:Clone()

			local fallback = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
				or char:FindFirstChild("HumanoidRootPart")
			for _, partFolder in ipairs(clone:GetChildren()) do
				local target = char:FindFirstChild(partFolder.Name) or fallback
				if target then
					for _, item in ipairs(partFolder:GetChildren()) do

						pcall(function() item:SetAttribute("NL_Aura", true) end)
						item.Parent = target
						live[#live + 1] = item
					end
				end
			end
			clone:Destroy()
			applySpeed()
			applyGlow()
		end

		pcall(stripAura)

		tc(LP.CharacterAdded:Connect(function()
			stripAura()
			if S.Aura then task.delay(1.2, function() pcall(S._ApplyAura) end) end
		end))
	end

do
