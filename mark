	end;

	-- one look for every world-space label: a pill, not a floating string
	S._MakeTag = function(parent)
		local tag = Instance.new("BillboardGui");
		tag.AlwaysOnTop = true;
		-- generous, because the pill inside sizes itself and a BillboardGui
		-- clips whatever will not fit its own box
		tag.Size = UDim2.fromOffset(260, 22);
		tag.StudsOffset = Vector3.new(0, 1.9, 0);
