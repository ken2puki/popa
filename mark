			if not animator then return; end;
			local r15 = hum.RigType == Enum.HumanoidRigType.R15;
			bangAnim.AnimationId = r15 and "rbxassetid://5918726674" or "rbxassetid://148840371";
			local ok, track = pcall(animator.LoadAnimation, animator, bangAnim);
			if not ok then return; end;
			track.Priority = Enum.AnimationPriority.Action;
			track.Looped = true;
