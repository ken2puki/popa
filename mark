		-- background instead of the background growing with them
		pill.AutomaticSize = Enum.AutomaticSize.X;
		pill.Size = UDim2.fromOffset(0, 22);
		pill.BackgroundColor3 = Color3.fromRGB(10, 11, 15);
		pill.BackgroundTransparency = 0.18;
		pill.BorderSizePixel = 0;
		pill.Parent = tag;
		Instance.new("UICorner", pill).CornerRadius = UDim.new(1, 0);

		-- a touch of vertical shading so the pill has a body instead of reading flat
		local sheen = Instance.new("UIGradient");
		sheen.Rotation = 90;
		sheen.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(46, 48, 60)),
