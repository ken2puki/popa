		local function resolveMappings(data)
			local key = tostring(data.id)
			if mapCache[key] then return mapCache[key] end
			local bundled = data.bundledItems
			if type(bundled) ~= "table" then return nil end
			local mappings = {}
			for _, ids in pairs(bundled) do
				if type(ids) == "table" then
					for _, assetId in pairs(ids) do
						local ok, objs = pcall(game.GetObjects, game, "rbxassetid://" .. tostring(assetId))
						if ok and objs then
							local function scan(parent, path)
								for _, child in ipairs(parent:GetChildren()) do
									if child:IsA("Animation") then
										local parts = (path .. "." .. child.Name):split(".")
										mappings[#mappings + 1] = {
											category = parts[#parts - 1],
											name = parts[#parts],
											id = child.AnimationId,
										}
									elseif #child:GetChildren() > 0 then
										scan(child, path .. "." .. child.Name)
									end
								end
							end
							for _, o in ipairs(objs) do
								scan(o, o.Name)
								pcall(function() o:Destroy() end)
							end
						end
					end
				end
			end
			mapCache[key] = mappings
			return mappings
		end

		local function applyCategory(animate, folderName, mappings)
			local items = {}
			for _, m in ipairs(mappings) do
				if m.category and m.category:lower() == folderName then
					items[m.name:lower()] = m.id
				end
			end
			if not next(items) then return end
			local folder = animate:FindFirstChild(folderName)
			if not folder then return end
			local _, first = next(items)
			for _, a in ipairs(folder:GetChildren()) do
				if a:IsA("Animation") then
					local id = items[a.Name:lower()] or first
					if id then
						local key = folderName .. "/" .. a.Name
						if origAnims[key] == nil then
							local oid = toAid(a.AnimationId)
							if oid then origAnims[key] = oid end
						end
						a.AnimationId = id
						local p = a.Parent
						a.Parent = nil
						a.Parent = p
					end
				end
			end
		end

		S.ApplyPack = function(packName)
			local c = LP.Character
			local hum = c and c:FindFirstChildOfClass("Humanoid")
			local animate = c and c:FindFirstChild("Animate")
			if not (hum and animate) then return end
			local name = packName or S.PackName or "Default"

			if name == "Default" then
				if next(origAnims) == nil then return end
				for key, id in pairs(origAnims) do
					local gn, cn = key:match("^(.-)/(.+)$")
					local g = gn and animate:FindFirstChild(gn)
					local ch = g and g:FindFirstChild(cn)
					local aid = toAid(id)
					if ch and aid then ch.AnimationId = aid end
				end
				origAnims = {}
				kickReload(hum, animate)
				return
			end

			local data = packByName[name]
			if not data then return end

			task.spawn(function()
				local mappings = resolveMappings(data)
				if not mappings or #mappings == 0 then return end
				local ch = LP.Character
				local h = ch and ch:FindFirstChildOfClass("Humanoid")
				local an = ch and ch:FindFirstChild("Animate")
				if not (h and an) then return end
				for _, folderName in ipairs({ "idle", "walk", "run", "jump", "fall", "climb", "swim", "swimidle" }) do
					applyCategory(an, folderName, mappings)
				end
				kickReload(h, an)
			end)
		end

		tc(LP.CharacterAdded:Connect(function(ch)
			local name = S.PackName
			if not name or name == "Default" then return end
			task.spawn(function()
