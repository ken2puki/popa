	S.Desync      = false;
	S.DesyncSpan  = 7777;
	S.DesyncMode  = "CFrame";
	S.DesyncModes = { "CFrame", "Packet" };
	S.PacketHold    = 400;
	S.PacketRelease = 120;

	do
		local applied, appliedTo = false, nil;
		local lastCF, lastVel, lastAng = nil, nil, nil;
		local flip = 0;

		local function restoreNow()
			if not applied then return end;
			applied = false;
			local hrp = appliedTo;
			appliedTo = nil;
			if hrp and hrp.Parent and lastCF then

				flip = flip + 1;
				hrp.CFrame = lastCF + Vector3.new(0, (flip % 2 == 0) and 0.001 or -0.001, 0);
				if lastVel then hrp.AssemblyLinearVelocity = lastVel end;
				if lastAng then hrp.AssemblyAngularVelocity = lastAng end;
			end;
			lastCF, lastVel, lastAng = nil, nil, nil;
		end;
		S._DesyncRestoreNow = restoreNow;

		local function setClimb(enabled)
			local c = LP.Character;
			local hum = c and c:FindFirstChildOfClass("Humanoid");
			if hum then
				pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, enabled) end);
			end;
		end;

		local rnLib = getfenv().raknet or (getgenv and getgenv().raknet) or rawget(_G, "raknet");
		local rnHook, rnBlocking = nil, false;

		local function packetStop()
			rnBlocking = false;
			if rnHook and rnLib and rnLib.remove_send_hook then
				pcall(rnLib.remove_send_hook, rnHook);
			end;
			rnHook = nil;
		end;

		local function packetStart()
			if rnHook then return true end;
			if not (rnLib and rnLib.add_send_hook) then return false end;
			local ok, h = pcall(rnLib.add_send_hook, function(pk)
				if rnBlocking and pk.PacketId == 131 then return false end;
				return true;
			end);
			if not ok or not h then return false end;
			rnHook = h;
			task.spawn(function()
				while rnHook do
					rnBlocking = true;
					task.wait(math.max(tonumber(S.PacketHold) or 400, 30) / 1000);
					rnBlocking = false;
					task.wait(math.max(tonumber(S.PacketRelease) or 120, 15) / 1000);
				end;
			end);
			return true;
		end;
		S._PacketDesyncAvailable = function() return rnLib ~= nil and rnLib.add_send_hook ~= nil end;

		S._DesyncStart = function()
			if S.DesyncMode == "Packet" then
				if not packetStart() then
					S.Desync = false;
					pcall(function()
						NeverLose:CreateNotification().new({ Title = "Desync",
							Content = "Packet mode needs a raknet-capable executor", Duration = 4 });
					end);
					return;
				end;
				S.Desync = true;
				return;
			end;
			S.Desync = true;
			setClimb(false);
		end;

		S._DesyncStop = function()
			S.Desync = false;
			packetStop();
			local home = nil;
			local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart");
			if hrp and lastCF then home = lastCF end;
			restoreNow();
			if not home then
				home = hrp and hrp.CFrame or nil;
			end;
			setClimb(true);
			if not (hrp and home) then return end;
			task.spawn(function()
				local until_ = os.clock() + 0.35;
				while os.clock() < until_ do
					if not (hrp.Parent and not S.Desync) then return end;
					pcall(function()
						hrp.CFrame = home;
						hrp.AssemblyLinearVelocity = Vector3.zero;
						hrp.AssemblyAngularVelocity = Vector3.zero;
					end);
					RunService.Heartbeat:Wait();
				end;
			end);
		end;

		tc(RunService.Heartbeat:Connect(function()
			restoreNow();
			if not S.Desync or S.DesyncMode == "Packet" then return end;
			local char = LP.Character;
			local hrp = char and char:FindFirstChild("HumanoidRootPart");
			local hum = char and char:FindFirstChildOfClass("Humanoid");
			if not (hrp and hum and hum.Health > 0) then return end;

			local span = tonumber(S.DesyncSpan) or 7777;
			local rnd = math.random;
			local off = Vector3.new((rnd() * 2 - 1) * span, rnd() * span, (rnd() * 2 - 1) * span);
			local rot = CFrame.Angles(rnd() * 6.2832, rnd() * 6.2832, rnd() * 6.2832);

			lastCF  = hrp.CFrame;
			lastVel = hrp.AssemblyLinearVelocity;
			lastAng = hrp.AssemblyAngularVelocity;
			applied, appliedTo = true, hrp;
			hrp.CFrame = (lastCF + off) * rot;

			hrp.AssemblyLinearVelocity = lastVel + Vector3.new(0, 0.05, 0);
		end));

		local bindName = "NL_DesyncRestore" .. tostring(math.random(1, 1e9));
		RunService:BindToRenderStep(bindName, Enum.RenderPriority.First.Value - 1, restoreNow);
		S._DesyncUnbind = function()
			pcall(function() RunService:UnbindFromRenderStep(bindName) end);
		end;

		tc(LP.CharacterAdded:Connect(function()
			applied, appliedTo = false, nil;
			lastCF, lastVel, lastAng = nil, nil, nil;
			if S.Desync then task.defer(function() setClimb(false) end) end;
		end));
	end;

	for _, where in ipairs({ workspace, game:GetService("Lighting") }) do
		for _, o in ipairs(where:GetChildren()) do
			if o.Name == "NL_DesyncClone" then pcall(function() o:Destroy() end) end;
		end;
	end;

