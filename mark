		function ConfigLib:GetData(performance)
			local ikc = {};

			local cd = 0;
			for Flag, v in pairs(NeverLose.Flags) do
				if v and v.GetValue then
					local ok, data = pcall(function() return v:GetValue() end);
					if ok and data ~= nil then
						if typeof(data) == 'Color3' then
							table.insert(ikc, {
								Idx = Flag,
								Type = "Color",
								Value = data:ToHex(),
							});
						elseif typeof(data) == 'EnumItem' then
							table.insert(ikc, {
								Idx = Flag,
								Type = "Enum",
								Value = data.Name,
							});
						else
							table.insert(ikc, {
								Idx = Flag,
								Value = data
							});
						end;
					end;
				end;

				if performance then
					if cd % 35 == 1 then
						task.wait()
					end
				end;

				cd += 1;
			end;

			return NeverLose.Base64Encode(Encryption.new(HttpService:JSONEncode(ikc)));
		end;

		function ConfigLib:LoadData(data)
			if not data or data == "" then return end;
			local ok, decoded = pcall(function()
				return HttpService:JSONDecode(Encryption.reverse(NeverLose.Base64Decode(data)));
			end);
			if not ok or not decoded then return end;

			for _, v in ipairs(decoded) do
				if v and v.Idx and NeverLose.Flags[v.Idx] then
					task.spawn(function()
						pcall(function()
							NeverLose.Flags[v.Idx]:SetValue(v.Value);
						end);
					end);
				end;
			end;
		end;

