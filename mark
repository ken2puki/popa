	local function loadCatalogue()
	    local ok, body = pcall(function() return game:HttpGet(MODEL_HOST .. "index.json") end)
	    if not ok or type(body) ~= "string" then return false end
	    local ok2, list = pcall(function()
	        return game:GetService("HttpService"):JSONDecode(body)
	    end)
	    if not ok2 or type(list) ~= "table" then return false end
	    for _, e in ipairs(list) do
	        if type(e) == "table" and e.name and e.file then CATALOGUE[e.name] = e.file end
	    end
	    return true
