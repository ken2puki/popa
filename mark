			end;

			local now = os.clock();
			record(now);

			local depth = (tonumber(S.BacktrackDepth) or 0) / 1000;
			if depth <= 0 then
				local ok, ping = pcall(function() return LP:GetNetworkPing() end);
				depth = (ok and ping) or 0.08;
			end;
			depth = math.clamp(depth, 0.02, HIST_MAX - 0.1);
			local smooth = math.clamp(dt * 18, 0, 1);
			local style = STYLE[S.BacktrackStyle] or STYLE.Highlight;
			local color = style.chroma and Color3.fromHSV((os.clock() * 0.05) % 1, 1, 1) or S.BacktrackColor;
			local alpha = math.clamp(style.alpha + (1 - (tonumber(S.BacktrackOpacity) or 65) / 100) * 0.6, 0, 1);
			local mode = S.BacktrackTarget or "Others";

			for _, p in ipairs(Players:GetPlayers()) do
				local want = (mode == "All") or (mode == "Me" and p == LP) or (mode == "Others" and p ~= LP);
				local char = want and p.Character;
				local hrp = char and char:FindFirstChild("HumanoidRootPart");
				local hum = hrp and char:FindFirstChildOfClass("Humanoid");

