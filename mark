	local function dressKnife(part)
		if not (part and part:IsA("BasePart")) then return end
	if S.ThrowKnifeAura and not part:GetAttribute("MM2AuraArmed") then
		pcall(function() part:SetAttribute("MM2AuraArmed", true) end)
		task.spawn(function()
			local hit = {}
			local born = os.clock()
			while part.Parent and S.ThrowKnifeAura and os.clock() - born < 4 do

				local kv = part.AssemblyLinearVelocity
				if not kv or kv.Magnitude < 6 then break end
				local range = math.clamp(tonumber(S.ThrowAuraRange) or 12, 1, 60)
				for _, p in ipairs(Players:GetPlayers()) do
						if p ~= LP and not hit[p] and not isWhitelisted(p) and p.Character then
							local r = p.Character:FindFirstChild("HumanoidRootPart")
							local hum = p.Character:FindFirstChildOfClass("Humanoid")
							if r and hum and hum.Health > 0 and (r.Position - part.Position).Magnitude <= range then
								hit[p] = true; pcall(killInstant, p)
							end
						end
					end
					RunService.Heartbeat:Wait()
				end
			end)
		end
	end
	local function onThrown(obj)
		if not S.ThrowKnifeAura then return end
		task.spawn(function()
			for _ = 1, 30 do
				if not obj.Parent then return end
				local vis = obj:FindFirstChild("KnifeVisual")
				if vis then dressKnife(vis); return end
				task.wait(0.03)
			end
		end)
	end
	tc(CollSvc:GetInstanceAddedSignal("ThrowingKnife"):Connect(onThrown))
	for _, obj in ipairs(CollSvc:GetTagged("ThrowingKnife")) do onThrown(obj) end

