	local MSP = { History = {}, Latency = 0, Jitter = 0 }
	-- nothing in MM2 legitimately moves this fast; anything above it is a
	-- teleport and must not reach the velocity filter
	local MSP_MAX_SPEED = 300
	local MSP_MIN_DT = 1 / 120
	local function getPing()
		local ping = 0
		pcall(function() ping = LP:GetNetworkPing() * 1000 end)
		return math.clamp(ping, 0, 800)
	end
	local pingSamples, pingHead = {}, 0
	local function trackJitter(pingMs)
		pingHead = (pingHead % 40) + 1
		pingSamples[pingHead] = pingMs
		local lo, hi = math.huge, -math.huge
		for _, v in pairs(pingSamples) do if v < lo then lo = v end if v > hi then hi = v end end
		if lo <= hi then MSP.Jitter = math.clamp((hi - lo) / 2000, 0, 0.15) end
	end
	tc(RunService.Heartbeat:Connect(function()
		if not (S.KnifeSilentAim or S.SheriffSilentAim or S.Wallbang or S.ForceShoot) then return end
		local pingMs = getPing()
		MSP.Latency = pingMs / 1000
		trackJitter(pingMs)
		local now = tick()
		for _, p in ipairs(Players:GetPlayers()) do
			local ch = p.Character
			local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
			if hrp then
				local e = MSP.History[p.Name]
				if not e then
					MSP.History[p.Name] = { Pos = hrp.Position, Time = now, Vel = Vector3.new(), Acc = Vector3.new() }
				else
					local dt = now - e.Time
					if dt >= MSP_MIN_DT then
						local step = hrp.Position - e.Pos
						local newVel = step / dt
						if newVel.Magnitude > MSP_MAX_SPEED then
							-- a teleport, not movement: resync the anchor and
							-- drop the derived terms rather than feeding a
							-- four-figure velocity into the smoothing
							e.Pos, e.Time = hrp.Position, now
							e.Vel, e.Acc = Vector3.new(), Vector3.new()
						else
							local rawAcc = (newVel - (e.Vel or newVel)) / dt
							e.Acc = (e.Acc or Vector3.new()):Lerp(rawAcc, 0.3)
							e.Vel = newVel; e.Pos = hrp.Position; e.Time = now
						end
					end
				end
			end
		end
	end))

