			if S.AspectRatio == "Custom" then

				return math.clamp((tonumber(S.AspectScale) or 80) / 100, 0.4, 1.1);
			end;
			local t = RATIOS[S.AspectRatio];
			if not t then return nil end;
			local vs = cam.ViewportSize;

			return math.clamp(t / (vs.X / math.max(vs.Y, 1)), 0.4, 1.1);
		end;

