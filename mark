		local clock = os.clock
		local random = math.random
		local rate_old = nil

		local function spoof_rate_enable()
			if rate_old == nil then
				pcall(function() rate_old = getfflag("S2PhysicsSenderRate") or "15" end)
			end
			pcall(function()
				setfflag("S2PhysicsSenderRate", tostring(math.floor(1 / math.max(RunService.Heartbeat:Wait(), 1e-3) + 0.5)))
			end)
		end

		local function spoof_rate_disable()
			if rate_old ~= nil then
				pcall(function() setfflag("S2PhysicsSenderRate", rate_old) end)
				rate_old = nil
			end
		end
		S._VelSpoofDisable = spoof_rate_disable

		local busy = false
		tc(RunService.Heartbeat:Connect(function()
			if not S.VelSpoof or busy then return end

			if S._flingBusy or (S.TouchFling and true or false) then return end
			local char = LP.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if not hrp then return end

			busy = true
			pcall(spoof_rate_enable)
			pcall(function() sethiddenproperty(hrp, "NetworkIsSleeping", false) end)

			local old_lin = hrp.AssemblyLinearVelocity
			local old_ang = hrp.AssemblyAngularVelocity

			local t = S.VelSpoofMode
			local vel = t == "y high" and Vector3.new(0, 16384, 0)
				or t == "limit" and Vector3.new(
					random(-9223372036854775808, 9223372036854775807),
					random(-9223372036854775808, 9223372036854775807),
					random(-9223372036854775808, 9223372036854775807)
				)
				or t == "low" and Vector3.new(
					random(1, 2) == 1 and -300 or 300,
					random(1, 2) == 1 and -300 or 300,
					random(1, 2) == 1 and -300 or 300
				)
				or t == "high" and Vector3.new(
					random(1, 2) == 1 and -16384 or 16384,
					random(1, 2) == 1 and -14384 or 16384,
					random(1, 2) == 1 and -16384 or 16384
				)
				or t == "zero" and Vector3.zero
				or Vector3.zero

			getgenv().VELOCITY_DESYNC_UNTIL = clock() + 0.35
			pcall(function()
				hrp.AssemblyLinearVelocity = vel
				if S.VelSpoofRotate then hrp.AssemblyAngularVelocity = vel end
			end)

			RunService.RenderStepped:Wait()
			pcall(function()
				if hrp.Parent then
					hrp.AssemblyLinearVelocity = old_lin
					hrp.AssemblyAngularVelocity = old_ang
				end
			end)
			getgenv().VELOCITY_DESYNC_UNTIL = clock() + 0.05
			busy = false
		end))
