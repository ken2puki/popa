								end;
								if copy.Color ~= color then copy.Color = color end;
								if copy.Transparency ~= alpha then copy.Transparency = alpha end;
							else
								if copy.Transparency ~= 1 then copy.Transparency = 1 end;
							end;
						end;
					end;
