			sweepAt = now;
			for sound in pairs(saved) do
				if sound.Parent and sound.Volume ~= 0 and wanted(sound) then
					pcall(function() sound.Volume = 0 end);
				end;
			end;
		end));

		S._ApplyMute = function()
			if not S.Mute then
				for sound in pairs(saved) do restore(sound) end;
				table.clear(saved);
				return;
			end;
			for _, d in ipairs(game:GetDescendants()) do
