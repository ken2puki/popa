			local char = LocalPlayer.Character;
			local root = char and char:FindFirstChild("HumanoidRootPart");
			local hum  = char and char:FindFirstChildOfClass("Humanoid");
			local pl = firstSelected();
			local tChar = pl and pl.Character;
			if not (root and hum and hum.Health > 0 and tChar) then return; end;

			local tHead = tChar:FindFirstChild("Head");
			local tRoot = tChar:FindFirstChild("HumanoidRootPart");

			local function pin(cf)
				root.CFrame = cf;
				root.AssemblyLinearVelocity = Vector3.zero;
				root.AssemblyAngularVelocity = Vector3.zero;
			end;

			if S.HeadSit and tHead then
				stopBang();
				hum.Sit = true;
				pin(tHead.CFrame * CFrame.new(0, 1.4, 0));
			elseif S.BangTarget and tRoot then

				ensureBangTrack(hum);
				local behind = tRoot.CFrame * CFrame.new(0, 0, 1.1);
				pin(CFrame.lookAt(behind.Position, tRoot.Position));
			elseif S.MouthBangTarget and tHead then

				ensureBangTrack(hum);
				local front = tHead.CFrame * CFrame.new(0, 0, -1.2);
				pin(CFrame.lookAt(front.Position, tHead.Position));
