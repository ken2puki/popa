			S._movTookSpeed = true;
			S._movDirty = true;
		elseif saved and S._movTookSpeed then
			-- the game does not keep everyone at 16; hand back what it had.
			-- only if this script is what changed it, or we would pin the game
			-- to a stale value it never asked for
			if hum.WalkSpeed ~= saved.speed then hum.WalkSpeed = saved.speed end;
			S._movTookSpeed = nil;
			S._movDirty = nil;
