			Sakura    = "rbxassetid://81755778619404",
			Wind      = "rbxassetid://80694081850877",
			Flow      = "rbxassetid://119913533725648",
			Star      = "rbxassetid://73754563740680",
		}
		S.AuraNames = { "Angel", "Starlight", "Heavenly", "Ribbon", "Sakura", "Wind", "Flow", "Star" }
		S.AuraName  = "Angel"
		S.AuraSpeed = 100
		S.AuraGlow  = 100
		S.Aura      = false

		local cache = {}
