		-- bridge onto the menu, which already drives S._ApplyShader/_RestoreShader
		S._ApplyShader = function()
			shader_type = string.lower(tostring(S.ShaderPreset))
			local d = shaders[shader_type] or shaders.midday
			shader_enabled = true
			apply_shader(d)
			if shader_connection then return end
			local shader_accum = 0
			shader_connection = RunService.Heartbeat:Connect(function(dt)
				if not shader_enabled then return end
				local cur = shaders[shader_type]
				if not cur then return end
				shader_accum = shader_accum + dt
				if shader_accum >= 1 then
					shader_accum = 0
					apply_shader(cur)
					return
				end
				if lighting.Ambient ~= cur.yfbghj
					or lighting.Brightness ~= cur.khnbfth
					or lighting.ClockTime ~= cur.tgvbyd
					or lighting.OutdoorAmbient ~= cur.hyhnngtf
					or lighting.ExposureCompensation ~= cur.hdfr7thgr
					or lighting.GlobalShadows ~= cur.hgnujuu7thgr
					or lighting.ColorShift_Top ~= cur.yfbhjku
					or lighting.FogEnd ~= math.huge then
					apply_shader(cur)
				end
			end)
		end

		S._RestoreShader = disable_shader
		S._SetReflect = function(v)
			local r = math.clamp((tonumber(v) or 0) / 100, 0, 1);
			task.spawn(function()
				if r > 0 then
					local bank = rawget(_G, "__MM2_REFL");
					if type(bank) ~= "table" then bank = {}; _G.__MM2_REFL = bank end;
					for _, o in ipairs(workspace:GetDescendants()) do
						if o:IsA("BasePart") and not o:IsDescendantOf(workspace.Terrain) then
							if bank[o] == nil then bank[o] = o.Reflectance end;
							pcall(function() o.Reflectance = r end);
						end;
					end;
				else
					S._RestoreReflect();
				end;
			end);
		end;

		S._RestoreReflect = function()
			local bank = rawget(_G, "__MM2_REFL");
			if type(bank) ~= "table" then return 0 end;
			local n = 0;
			for o, was in pairs(bank) do
				if typeof(o) == "Instance" and o.Parent then
					pcall(function() o.Reflectance = was end);
					n = n + 1;
				end;
			end;
			_G.__MM2_REFL = nil;
			return n;
		end;


