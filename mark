		if not (S.MovSpeed or S.MovJump or S.Noclip or S._ncWas or S._movDirty
			or S._movTookSpeed or S._movTookJump) then return end;
		local char = LP.Character;
		local hum = char and char:FindFirstChildOfClass("Humanoid");
		if not hum then return end;

		if (S.MovSpeed or S.MovJump) and not S._movSaved then
