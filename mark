		end

		tc(RunService.Heartbeat:Connect(function()
			if not (S.RoleChams or S._chamsOn) then return end
			local now = os.clock()
			if now - S._chamsAt < 0.1 then return end
			S._chamsAt, S._chamsOn = now, S.RoleChams

			local spec = STYLE[S.ChamsStyle] or STYLE.Highlight

			for _, p in ipairs(Players:GetPlayers()) do
				local ch = p ~= LP and p.Character
				local hum = ch and ch:FindFirstChildOfClass("Humanoid")
				local role = (S.RoleChams and hum and hum.Health > 0) and getRole(p) or nil
				local col = role and S.ChamsRole[role] and S.ChamsColor[role]

				if not col then
					drop(p)
				else
					local r = rigs[p]

					if r and (r.char ~= ch or r.style ~= S.ChamsStyle or not r.model.Parent) then
						drop(p)
						r = nil
					elseif r and now - (r.checked or 0) > 1 then
						r.checked = now
						if r.count ~= #bones(ch) then
							drop(p)
							r = nil
						end
					end
					if not r then r = build(p, ch, spec) end
					if r then
						r.style = S.ChamsStyle
						local c = col
						if spec.chroma then
							local h = (now * 0.05) % 1
							local s = (1 + math.sin(now * 0.9)) / 4 + 0.75
							local v = (1 + math.sin(now * 1.4 + 1.3)) / 4 + 0.75
							c = Color3.fromHSV(h, math.clamp(s, 0, 1), math.clamp(v, 0, 1))
						end
						r.occ.FillColor, r.occ.OutlineColor = c, S._ChamEdge(c)
						r.occ.FillTransparency, r.occ.OutlineTransparency = spec.fill, spec.outline
						r.los.FillColor, r.los.OutlineColor = c, S._ChamEdge(c)
						r.los.FillTransparency, r.los.OutlineTransparency = spec.fill, spec.outline
					end
				end
			end

			for pl in pairs(rigs) do
				if pl.Parent == nil then drop(pl) end
			end
		end))

		tc(Players.PlayerRemoving:Connect(drop))
	end

	do
