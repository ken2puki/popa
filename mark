	local function getPredictedPosition(targetChar, partName, mode, predAmount, pingOff, bulletSpeed)
		local hrp = targetChar:FindFirstChild("HumanoidRootPart")
		local part = targetChar:FindFirstChild(partName) or targetChar:FindFirstChild("Head")
			or targetChar:FindFirstChild("UpperTorso") or targetChar:FindFirstChild("Torso") or hrp
		if not part or not hrp then return Vector3.new() end
		if predAmount == 0 then return part.Position end
		local hist = MSP.History[targetChar.Name]
		local vel  = hrp.AssemblyLinearVelocity
		if vel ~= vel or vel.Magnitude > 300 then vel = (hist and hist.Vel) or Vector3.new() end
		local ping = MSP.Latency + (pingOff or 0)
		local pos  = part.Position
		if mode == "Standard" then
			return pos + vel * (predAmount / 100)
		elseif mode == "Perfect" or mode == "Adaptive" then

			local jitter = (mode == "Adaptive") and (math.clamp(MSP.Jitter or 0, 0, 0.15)) or 0
			local t = (ping * 2 + jitter) * (predAmount / 100)
			if bulletSpeed and bulletSpeed > 0 then
				local sh = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
				if sh then t = t + ((pos - sh.Position).Magnitude / bulletSpeed) end
			end
			t = math.min(t, 0.35)
			return pos + vel * t
		end
		return pos
	end
	local PredictPresets = {
		Off      = { mode = "Off",      amount = 0,   ping = 0 },
		Standard = { mode = "Standard", amount = 100, ping = 0 },
		Normal   = { mode = "Perfect",  amount = 100, ping = 0 },
		Adaptive = { mode = "Adaptive", amount = 100, ping = 0 },
	}
	S.PredictModes = { "Normal", "Standard", "Adaptive", "Off" }
	local function _Predict(targetChar, partName, presetName, bulletSpeed, amount)
		local pre = PredictPresets[presetName] or PredictPresets.Normal
		local amt = amount or pre.amount
		if pre.mode == "Off" then amt = 0 end
		return getPredictedPosition(targetChar, partName, pre.mode, amt, pre.ping, bulletSpeed)
	end

	-- how wide a cone counts as "aiming at", and how far a knife is worth
	-- throwing; beyond these the pick falls back to plain distance
	local SILENT_CONE = math.rad(55)
	local SILENT_RANGE = 400

	local function silentAimTargetChar(mode, fov, wallCheck, aimPartName)
		local lpChar = LP.Character
		-- one origin for both the range test and the wall trace: measuring
		-- range from the root while tracing sight from the head let a target
		-- pass one check on geometry the other never saw
		local lpPart = lpChar and (lpChar:FindFirstChild("Head") or lpChar:FindFirstChild("HumanoidRootPart"))
		if not lpPart then return nil end
		local origin = lpPart.Position

		local cam = workspace.CurrentCamera
		local look = cam and cam.CFrame.LookVector or nil
		local cone = SILENT_CONE
		if type(fov) == "number" and fov > 0 then cone = math.rad(math.clamp(fov, 1, 180)) end

		local rp
		if wallCheck then rp = RaycastParams.new(); rp.FilterType = Enum.RaycastFilterType.Exclude end

		-- aimed: inside the cone, ranked by angle. loose: anything visible,
		-- ranked by distance, used only when the cone is empty
		local best, bestAng = nil, math.huge
		local loose, looseD = nil, math.huge

		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LP and p.Character and not isWhitelisted(p) then
				local hum = p.Character:FindFirstChildOfClass("Humanoid")
				if hum and hum.Health > 0 then
					local head = p.Character:FindFirstChild(aimPartName or "Head")
						or p.Character:FindFirstChild("Head") or p.Character:FindFirstChild("UpperTorso")
						or p.Character:FindFirstChild("Torso") or p.Character:FindFirstChild("HumanoidRootPart")
					if head then
						local r = getRole(p)
						local ok = (mode == "Nearest") or (mode == "SheriffOrHero" and (r == "Sheriff" or r == "Hero")) or (mode == r)
						if ok then
							local delta = head.Position - origin
							local d = delta.Magnitude
							if d <= SILENT_RANGE and d > 0 then
								local vis = true
								if wallCheck then
									rp.FilterDescendantsInstances = { lpChar, p.Character }
									if workspace:Raycast(origin, delta, rp) then vis = false end
								end
								if vis then
									if d < looseD then looseD = d; loose = p.Character end
									if look then
										local ang = math.acos(math.clamp(look:Dot(delta.Unit), -1, 1))
										-- inside the cone the closest to the
										-- crosshair wins, not the closest in space
										if ang <= cone and ang < bestAng then
											bestAng = ang
											best = p.Character
										end
									end
								end
							end
						end
					end
				end
			end
		end

		return best or loose
	end

	local function getMurdererChar()
		local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
		local best, bestD = nil, math.huge
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LP and p.Character and not isWhitelisted(p) and getRole(p) == "Murderer" then
				local hum = p.Character:FindFirstChildOfClass("Humanoid")
				local hrp = p.Character:FindFirstChild("HumanoidRootPart")
				if hum and hum.Health > 0 and hrp then
					local d = myHrp and (hrp.Position - myHrp.Position).Magnitude or 0
					if d < bestD then bestD, best = d, p.Character end
				end
			end
		end
		return best
	end
	local function hasLOS(fromPos, targetPart)
		if not (fromPos and targetPart) then return false end;
		local rp = RaycastParams.new();
		rp.FilterType = Enum.RaycastFilterType.Exclude;
		rp.FilterDescendantsInstances = { LP.Character, targetPart.Parent };
		local hit = workspace:Raycast(fromPos, targetPart.Position - fromPos, rp);
		return hit == nil;
	end;

	local function handleFireServer(self, ...)
		local args = { ... }
		if self.Name == "KnifeThrown" and S.KnifeSilentAim then
			local wc = S.KnifeWallCheck == true
			local targetChar = silentAimTargetChar("SheriffOrHero", nil, wc, "Head")
				or silentAimTargetChar("Nearest", nil, wc, "Head")
			if not targetChar then return nil end
			local aimPart = targetChar:FindFirstChild("Head") or targetChar:FindFirstChild("UpperTorso")
				or targetChar:FindFirstChild("Torso") or targetChar:FindFirstChild("HumanoidRootPart")
			if not aimPart then return nil end
			local pos
			if S.KnifePredict then
				local p = _Predict(targetChar, aimPart.Name,
					S.KnifePredictMode or "Normal", 80,
					tonumber(S.KnifePredictAmt) or 100)
				if p ~= Vector3.new() then
					pos = p
				else
					pos = aimPart.Position
				end
			else
				pos = aimPart.Position
			end
			args[2] = (typeof(args[2]) == "Vector3") and pos or CFrame.new(pos)
			return args
		end
		return nil
	end
	if hookmetamethod then
		local oldNamecall
		oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
			local cc = checkcaller and checkcaller()
			if not cc and getnamecallmethod() == "FireServer" then
				local ok, modArgs = pcall(handleFireServer, self, ...)
				if ok and type(modArgs) == "table" then
					return self.FireServer(self, table.unpack(modArgs))
				end
				return self.FireServer(self, ...)
			end
			return oldNamecall(self, ...)
		end))
	end

