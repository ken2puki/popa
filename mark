	local function fetchDump(name)
	    if DUMPS[name] then return DUMPS[name] end
	    local file = CATALOGUE[name]
	    if not file then return nil end
	    local ok, body = pcall(function() return game:HttpGet(MODEL_HOST .. file) end)
	    if not ok or type(body) ~= "string" or #body < 64 then return nil end
	    DUMPS[name] = body
	    return body
	end

