		local function findRemote()
			local cs = RS:FindFirstChild("ClientServices")
			local ws = cs and cs:FindFirstChild("WeaponService")
			local ev = ws and ws:FindFirstChild("GunFired")
			if ev and ev:IsA("RemoteEvent") then return ev end

			local any = RS:FindFirstChild("GunFired", true)
			if any and any:IsA("RemoteEvent") then return any end
			return nil
		end

		local function isMine(gun)
			if typeof(gun) ~= "Instance" then return false end
			local ch = LP.Character
			if ch and gun:IsDescendantOf(ch) then return true end
			local model = gun:FindFirstAncestorOfClass("Model")
			while model do
				if Players:GetPlayerFromCharacter(model) then
					return Players:GetPlayerFromCharacter(model) == LP
				end
				model = model:FindFirstAncestorOfClass("Model")
			end

			local bp = LP:FindFirstChildOfClass("Backpack")
			return bp ~= nil and gun:IsDescendantOf(bp)
		end

		local function connect_gun_fired()
			if not (S.ShotSound or S.Tracers) then return end
			local remote = findRemote()
			if not remote then return end
			if gun_fired_conn and gun_fired_remote == remote and gun_fired_conn.Connected then return end
			if gun_fired_conn then pcall(function() gun_fired_conn:Disconnect() end) gun_fired_conn = nil end
			gun_fired_remote = remote
			gun_fired_conn = remote.OnClientEvent:Connect(function(gun, from, to)
				task.spawn(function()
					local mine = isMine(gun)

					if S.ShotSound and (mine or not S.ShotSelfOnly) then
						pcall(S._PlayShotSound)
					end

					if S.Tracers and S._OnGunFiredTracer then
						pcall(S._OnGunFiredTracer, gun, from, to, mine)
					end
				end)
			end)
		end
		S._ConnectGunFired = connect_gun_fired

		task.spawn(function()
			while not S.Destroyed do
				pcall(connect_gun_fired)
				task.wait(1)
			end
		end)
	end

