					math.floor(cell / ART_COLS) * ART_FRAME)
			end

			for i, img in ipairs(artFrames) do
				img.Visible = true
				img.ImageRectOffset = slot(0)
				img.ImageTransparency = i == 1 and 0 or HIDDEN
			end

			local function show(index)
				local sheet = math.floor(index / per) + 1
				local alpha = math.clamp(tonumber(S.MenuArtFade) or 0.85, 0, 1)
				for i, img in ipairs(artFrames) do
					img.ImageTransparency = (i == sheet) and alpha or HIDDEN
				end
				local cur = artFrames[sheet]
				if cur then cur.ImageRectOffset = slot(index) end

				local nxt = (index + 1) % total
				local nsheet = math.floor(nxt / per) + 1
				if nsheet ~= sheet and artFrames[nsheet] then
					artFrames[nsheet].ImageRectOffset = slot(nxt)
				end
			end
			show(0)

			artConn = RunService.RenderStepped:Connect(function(dt)
				if not artHost or not artHost.Parent or S.MenuArt == "Off" then return end
				artAcc = artAcc + dt
				local step = 1 / math.clamp(tonumber(S.MenuArtFps) or 12, 1, 30)
				if artAcc < step then return end
				artAcc = 0

				if not ready then return end
				artIndex = (artIndex + 1) % total
				show(artIndex)
			end)
			return true
		end

		local function ingest(data)

			for _, kind in ipairs({ "cursors", "menusounds" }) do
				if type(data[kind]) == "table" then
					for _, e in ipairs(data[kind]) do
						if type(e) == "table" and e.name and e.file then
							catalogue[kind][e.name] = e.file
						elseif type(e) == "string" then
							catalogue[kind][pretty(e)] = e
						end
					end
				end
			end

			if type(data.menuart) == "table" then
				for _, file in ipairs(data.menuart) do
					if type(file) == "string" then
						local stem, idx = file:match("^(.-)_sheet_(%d+)%.%w+$")
						if stem then

							local label = pretty((stem:gsub("new$", "")))
							artSets[label] = artSets[label] or {}
							artSets[label][tonumber(idx)] = file
							catalogue.menuart[label] = file
						end

					end
				end
			end

			local skins = {}
			for name in pairs(catalogue.cursors) do skins[#skins + 1] = name end
			table.sort(skins)
			local cn = {}
			for _, name in ipairs(BUILTIN_CURSORS) do cn[#cn + 1] = name end
			for _, name in ipairs(skins) do cn[#cn + 1] = name end
			S.CursorSkins = skins
			S.CursorStyles = cn

			local sn = {}
			for name in pairs(catalogue.menusounds) do sn[#sn + 1] = name end
			table.sort(sn)
			S.MenuSoundNames = sn
			if S.MenuSoundName == "" and sn[1] then S.MenuSoundName = sn[1] end

			local an = { "Off" }
			for name in pairs(artSets) do an[#an + 1] = name end
			table.sort(an, function(a, b)
				if a == "Off" then return true end
				if b == "Off" then return false end
				return a < b
			end)
			S.MenuArts = an
		end

		S._IndexSettingsAssets = function()
			local ok, body = pcall(function() return game:HttpGet(HOST .. "index.json") end)
			if not ok or type(body) ~= "string" then return false end
			local ok2, data = pcall(function()
				return game:GetService("HttpService"):JSONDecode(body)
			end)
			if not ok2 or type(data) ~= "table" then return false end
			ingest(data)
			if S._RefreshSettingLists then pcall(S._RefreshSettingLists) end
			return true
		end

		task.spawn(function()
			for _ = 1, 3 do
				if S._IndexSettingsAssets() then return end
				task.wait(2)
			end
		end)
	end

