	-- far labels dim instead of crowding the skyline
	S._TintTag = function(tag, lbl, dot, edge, colour, dist)
		local far = math.clamp((dist - 140) / 180, 0, 1);
		local fade = far * 0.75;
		lbl.TextTransparency = fade;
		dot.BackgroundColor3 = colour;
		dot.BackgroundTransparency = fade;
		edge.Color = colour;
		edge.Transparency = 0.25 + fade * 0.6;
		local pill = tag:FindFirstChild("Pill");
		if pill then pill.BackgroundTransparency = 0.18 + fade * 0.6 end;
	end;

	S.ItemChams        = false;
	S.ItemChamsMode    = "Highlight";
	S.ItemChamsColor   = Color3.fromRGB(245, 245, 245);
	S.ItemChamsRainbow = false;
	S.ItemChamsLabel   = true;
	S.ItemChamsBackpack = false;
	S.ItemChamsModes   = { "Highlight", "Crystal", "Neon", "ForceField", "Chromatic" };

	do

		local FILL = {
			Highlight  = { 0.4,  0 },
			Crystal    = { 0.5,  0, Enum.Material.Glass },
			Neon       = { 0.35, 0, Enum.Material.Neon },
			ForceField = { 0.5,  0, Enum.Material.ForceField },
			Chromatic  = { 0.35, 0, Enum.Material.Glass, true },
		};
		local tracked, nextScan = {}, 0;
		local shells = {};
		-- the renderer only draws 31 Highlights; past that they silently vanish,
		-- so leave headroom for the gun / tool / role chams as well
		local HL_BUDGET = 20;

		local function shuck(inst)
			local sh = shells[inst];
			if sh then pcall(function() sh:Destroy() end) end;
			shells[inst] = nil;
		end;

		local function strip(inst)
			local tg = inst and inst.Parent and inst:FindFirstChild("NL_ItemTag");
			if tg then pcall(function() tg:Destroy() end) end;
			local hl = inst and inst.Parent and inst:FindFirstChild("NL_ItemCham");
			if hl then pcall(function() hl:Destroy() end) end;
			shuck(inst);
		end;
		S._ClearItemChams = function()
			for inst in pairs(tracked) do strip(inst) end;
			table.clear(tracked);
			for inst in pairs(shells) do shuck(inst) end;
			table.clear(shells);
		end;

		local function husk(inst, mode, material)
			local sh = shells[inst];
			if sh and sh.Parent and sh:GetAttribute("NL_Mode") == mode then return sh end;
			shuck(inst);
			if not (material and S._ChamShellPart) then return nil end;

			local model = Instance.new("Model");
			model.Name = "NL_ChamShell";
			model:SetAttribute("NL_Mode", mode);
			local made = 0;
			for _, d in ipairs(inst:GetDescendants()) do
				if d:IsA("BasePart") and not (S._ChamDeformable and S._ChamDeformable(d)) then
					local clone = S._ChamShellPart(d, 0.99);
					if clone then
						clone.Anchored = false;
						if S._ChamDress then S._ChamDress(clone, material) else clone.Material = material end;
						clone.CFrame = d.CFrame;
						clone.Parent = model;
						local weld = Instance.new("WeldConstraint");
						weld.Part0, weld.Part1 = clone, d;
						weld.Parent = clone;
						made = made + 1;
					end;
				end;
			end;
			if made == 0 then model:Destroy() return nil end;
			model.Parent = workspace;
			shells[inst] = model;
			return model;
		end;

		tc(RunService.Heartbeat:Connect(function()
			if not S.ItemChams then
				if next(tracked) then
					for inst in pairs(tracked) do strip(inst) end;
					table.clear(tracked);
				end;
				return;
			end;
			local now = os.clock();
			if now < nextScan then return end;
			nextScan = now + 0.2;

			local found = {};
			for _, p in ipairs(Players:GetPlayers()) do
				local char = p.Character;
				if char then
					for _, t in ipairs(char:GetChildren()) do
						if t:IsA("Tool") then found[t] = true end;
					end;
				end;
				if S.ItemChamsBackpack then
					local bp = p:FindFirstChildOfClass("Backpack");
					if bp then
						for _, t in ipairs(bp:GetChildren()) do
							if t:IsA("Tool") then found[t] = true end;
						end;
					end;
				end;
			end;

			local function sweep(container, depth)
				for _, v in ipairs(container:GetChildren()) do
					if v:IsA("Tool") or v.Name == "GunDrop" or v.Name == "Knife"
						or v.Name == "ThrowingKnife" or v.Name == "NormalKnife" then
						found[v] = true;
					elseif depth > 0 and (v:IsA("Folder") or v:IsA("Model"))
						and not Players:GetPlayerFromCharacter(v) then
						sweep(v, depth - 1);
					end;
				end;
			end;
			sweep(workspace, 1);

			-- keep the nearest ones: over the budget the extra Highlights would
			-- not render at all, and they would push the other chams out too
			local hrp0 = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart");
			local order = {};
			for inst in pairs(found) do order[#order + 1] = inst end;
			if hrp0 and #order > HL_BUDGET then
				local dist = {};
				for _, inst in ipairs(order) do
					local part = inst:IsA("BasePart") and inst
						or inst:FindFirstChildWhichIsA("BasePart", true);
					dist[inst] = part and (part.Position - hrp0.Position).Magnitude or math.huge;
				end;
				table.sort(order, function(a, b) return dist[a] < dist[b] end);
				for i = HL_BUDGET + 1, #order do
					local inst = order[i];
					found[inst] = nil;
					if tracked[inst] then strip(inst); tracked[inst] = nil end;
				end;
			end;

			local f = FILL[S.ItemChamsMode] or FILL.Highlight;
			local color = (S.ItemChamsRainbow or f[4])
				and Color3.fromHSV(os.clock() * 0.25 % 1, 0.85, 1)
				or S.ItemChamsColor;
			for inst in pairs(found) do
				pcall(function()
					local sh = husk(inst, S.ItemChamsMode, f[3]);

					local hl = inst:FindFirstChild("NL_ItemCham");
					if not (hl and hl:IsA("Highlight")) then
						hl = Instance.new("Highlight");
						hl.Name = "NL_ItemCham";
						hl.Parent = inst;
					end;
					hl.Adornee = sh or inst;
					hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop;
					hl.FillColor = color;
					hl.OutlineColor = S._ChamEdge(color);
					-- thin the fill out with range: the edge is what carries at
					-- distance, and a dozen solid fills becomes a wash
					local part0 = inst:IsA("BasePart") and inst
						or inst:FindFirstChildWhichIsA("BasePart", true);
					local away = (hrp0 and part0)
						and (part0.Position - hrp0.Position).Magnitude or 0;
					local thin = math.clamp((away - 60) / 200, 0, 1) * 0.4;
					hl.FillTransparency = math.min(1, f[1] + thin);
					hl.OutlineTransparency = f[2];

					local anchor = inst:IsA("Tool") and (inst:FindFirstChild("Handle")
						or inst:FindFirstChildWhichIsA("BasePart"))
						or (inst:IsA("BasePart") and inst)
						or inst:FindFirstChildWhichIsA("BasePart", true);
					local tag = inst:FindFirstChild("NL_ItemTag");
					if S.ItemChamsLabel and anchor then
						if not tag then
							tag = S._MakeTag(inst);
							tag.Name = "NL_ItemTag";
						end;
						tag.Adornee = anchor;
						local pill = tag:FindFirstChild("Pill");
						local row = pill and pill:FindFirstChildOfClass("Frame");
						local lbl = row and row:FindFirstChild("T");
						local dot = row and row:FindFirstChild("Dot");
						local edge = pill and pill:FindFirstChild("Edge");
						if lbl and dot and edge then
							local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart");
							local d = myHrp and (anchor.Position - myHrp.Position).Magnitude or 0;
							lbl.Text = ("%s  %dm"):format(inst.Name, d);
							S._TintTag(tag, lbl, dot, edge, color, d);
						end;
					elseif tag then
						tag:Destroy();
					end;
				end);
				tracked[inst] = true;
			end;
			for inst in pairs(tracked) do
				if not found[inst] or not inst.Parent then strip(inst); tracked[inst] = nil end;
			end;
			for inst in pairs(shells) do
				if not tracked[inst] then shuck(inst) end;
			end;
		end));
	end;

	S.GunChams      = false;
	S.GunChamsColor = Color3.fromRGB(255, 205, 70);
	S.GunChamsMode  = "Highlight";
	S.GunChamsDist  = true;

	do
		-- third slot is the material the mode paints on, fourth is rainbow
		local FILL = {
			Outline    = { 1, 0 },
			Solid      = { 0, 0 },
			Neon       = { 0.35, 0, Enum.Material.Neon },
			Crystal    = { 0.5, 0, Enum.Material.Glass },
			ForceField = { 0.5, 0.25, Enum.Material.ForceField },
			Highlight  = { 0.4, 0 },
			Chromatic  = { 0.35, 0, Enum.Material.Glass, true },
		};
		-- one entry per dropped gun: there can be more than one on the floor
		local gcMarks = {};

		local function gcDrop(drop)
			local m = gcMarks[drop];
			if not m then return end;
			if m.hl then pcall(function() m.hl:Destroy() end) end;
			if m.tag then pcall(function() m.tag:Destroy() end) end;
			for part, was in pairs(m.mat) do
				if part.Parent then pcall(function() part.Material = was end) end;
			end;
			gcMarks[drop] = nil;
		end;

		local function gcClear()
			for drop in pairs(gcMarks) do gcDrop(drop) end;
		end;
		S._ClearGunChams = gcClear;

		S._GunChamsAt = 0;
		tc(RunService.Heartbeat:Connect(function()
			if not S.GunChams then
				if gcHl or gcTag then gcClear() end;
				return;
			end;
			local now = os.clock();
			if now - S._GunChamsAt < 0.1 then return end;
			S._GunChamsAt = now;

			local drops = {};
			local function findDrops(container, depth)
				for _, v in ipairs(container:GetChildren()) do
					if v.Name == "GunDrop" then
						drops[#drops + 1] = v;
					elseif depth > 0 and (v:IsA("Folder") or v:IsA("Model"))
						and not Players:GetPlayerFromCharacter(v) then
						findDrops(v, depth - 1);
					end;
				end;
			end;
			findDrops(workspace, 2);

			local live = {};
			for _, drop in ipairs(drops) do live[drop] = true end;
			for drop in pairs(gcMarks) do
				if not (live[drop] and drop.Parent) then gcDrop(drop) end;
			end;
			if #drops == 0 then return end;

			local f = FILL[S.GunChamsMode] or FILL.Highlight;
			local gcCol = f[4] and Color3.fromHSV(os.clock() * 0.25 % 1, 0.85, 1) or S.GunChamsColor;
			local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart");

			for _, drop in ipairs(drops) do
				pcall(function()
					local adornee = (drop:IsA("Model") or drop:IsA("BasePart")) and drop or nil;
					if not adornee then
						adornee = drop:FindFirstChildWhichIsA("BasePart", true);
					end;
					if not adornee then return end;

					local m = gcMarks[drop];
					if not (m and m.hl and m.hl.Parent) then
						if m then gcDrop(drop) end;
						m = { mat = {} };
						m.hl = Instance.new("Highlight");
						m.hl.Name = "NL_GunCham";
						m.hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop;
						m.hl.Parent = adornee;
						gcMarks[drop] = m;
					end;
					m.hl.Adornee = adornee;
					m.hl.FillColor = gcCol;
					m.hl.OutlineColor = S._ChamEdge(gcCol);
					-- a slow breath on the outline: a gun on the floor should
					-- pull the eye without strobing
					local pulse = 0.5 + 0.5 * math.sin(os.clock() * 3);
					m.hl.FillTransparency = f[1];
					m.hl.OutlineTransparency = math.clamp(f[2] + pulse * 0.35, 0, 1);

					-- the mode's material, remembered so it can be handed back
					for _, d in ipairs(drop:GetDescendants()) do
						if d:IsA("BasePart") then
							if f[3] then
								if m.mat[d] == nil then m.mat[d] = d.Material end;
