	        ids.jump=ids.jump or "rbxassetid://125750702"
	        ids.fall=ids.fall or "rbxassetid://180436148"
	        ids.climb=ids.climb or "rbxassetid://180436334"
	    end

	    if not isR6 then
	        ids.idle=ids.idle or ids.idle1 or "rbxassetid://507766666"
	        ids.walk=ids.walk or "rbxassetid://507777826"
	        ids.run=ids.run or "rbxassetid://507767714"
	        ids.jump=ids.jump or "rbxassetid://507765000"
	        ids.fall=ids.fall or "rbxassetid://507767968"
	        ids.climb=ids.climb or "rbxassetid://507765644"
	        ids.swim=ids.swim or "rbxassetid://507784897"
	    end

	    local function pick(word)
	        if ids[word] then return ids[word] end
	        for k,v in pairs(ids) do if k:find(word,1,true) then return v end end
	    end
	    local map={
	        idle=pick("idle"), walk=pick("walk"), run=pick("run"),
	        jump=pick("jump"), fall=pick("fall"), climb=pick("climb"), swim=pick("swim")
	    }
	    for name,id in pairs(map) do
	        if id then loadedTracks[name]=loadAnim(animator,id,name=="idle" or name=="walk" or name=="run" or name=="climb" or name=="swim") end
	    end
	    local state=nil
	    local function play(name,speed)
	        local tr=loadedTracks[name]
	        if not tr then return end
	        if state~=name then
	            for n,x in pairs(loadedTracks) do if n~=name and x.IsPlaying then pcall(function() x:Stop(.12) end) end end
	            pcall(function() tr:Play(.12) end)
	            state=name
	        end
	        if speed then pcall(function() tr:AdjustSpeed(speed) end) end
	    end
	    return function()
	        if not realHum or not realRoot then return end
	        local st=realHum:GetState()
	        local v=realRoot.AssemblyLinearVelocity
	        local speed=Vector3.new(v.X,0,v.Z).Magnitude
	        if st==Enum.HumanoidStateType.Jumping then play("jump",1)
	        elseif st==Enum.HumanoidStateType.Freefall then play("fall",1)
	        elseif st==Enum.HumanoidStateType.Climbing then play("climb",math.max(math.abs(v.Y)/6,.4))
	        elseif st==Enum.HumanoidStateType.Swimming then play("swim",math.max(speed/8,.5))
	        elseif speed>12 then play("run",math.clamp(speed/16,.5,2))
	        elseif speed>.5 then play("walk",math.clamp(speed/8,.5,2))
	        else play("idle",1) end
	    end
	end

	local function reconstruct(data)
	    local objects=data.objects or {}
	    local inst={}
	    local rootModel

	    for i,od in pairs(objects) do
	        local class=od.class or "Folder"
	        local obj
	        if i==1 then
	            obj=Instance.new("Model")
	            rootModel=obj
	        elseif not SKIP[class] then
	            local ok,res=pcall(Instance.new,class)
	            if ok then obj=res end
	        end
	        if obj then
	            obj.Name=od.name or class
	            inst[i]=obj
	        end
	    end
	    assert(rootModel,"dump root could not be created")

	    for i,od in pairs(objects) do
	        local obj=inst[i]
	        if obj and i~=1 then
	            local p=inst[tonumber(od.parent)] or rootModel
	            pcall(function() obj.Parent=p end)
	        end
	    end

	    for i,od in pairs(objects) do
	        local obj=inst[i]
	        if obj and od.props then
	            for k,raw in pairs(od.props) do
	                if k~="Part0" and k~="Part1" and k~="CFrame" then
	                    local val=decode(raw)
	                    pcall(function() obj[k]=val end)
	                end
	            end
	            if od.props.CFrame then
	                local val=decode(od.props.CFrame)
	                pcall(function() obj.CFrame=val end)
	            end
	        end
	    end

	    for i,od in pairs(objects) do
	        local obj=inst[i]
	        if obj and od.props then
	            if od.props.Part0 then pcall(function() obj.Part0=inst[tonumber(od.props.Part0)] end) end
	            if od.props.Part1 then pcall(function() obj.Part1=inst[tonumber(od.props.Part1)] end) end
	        end
	    end

	    for _,x in ipairs(rootModel:GetDescendants()) do
	        if x:IsA("BasePart") then
	            x.Anchored=true
	            x.CanCollide=false
	            x.CanTouch=false
	            x.CanQuery=false
	            x.Massless=true
	        elseif x:IsA("Humanoid") then
	            x.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None
	            x.HealthDisplayType=Enum.HumanoidHealthDisplayType.AlwaysOff
	            x.NameDisplayDistance=0
	            x.AutoRotate=false
	            x.WalkSpeed=0
	            x.JumpPower=0
	        end
	    end

	    local root=rootModel:FindFirstChild("HumanoidRootPart",true) or rootModel:FindFirstChild("Torso",true) or rootModel:FindFirstChild("UpperTorso",true)
	    if root and root:IsA("BasePart") then
	        rootModel.PrimaryPart=root
	        root.Anchored=true
	    end

	    return rootModel
	end

	local function normalizeVisualScale(model,data)
	    local isR6=tostring(data.rigType or ""):find("R6")~=nil
	    local ratios={}

	    local function addRatio(partName, expected)
	        local p=model:FindFirstChild(partName,true)
	        if not p or not p:IsA("BasePart") then return end
	        ratios[#ratios+1]=p.Size.X/expected.X
	        ratios[#ratios+1]=p.Size.Y/expected.Y
	        ratios[#ratios+1]=p.Size.Z/expected.Z
	    end

	    if isR6 then
	        addRatio("HumanoidRootPart",Vector3.new(2,2,1))
	        addRatio("Torso",Vector3.new(2,2,1))
	        addRatio("Head",Vector3.new(2,1,1))
	        addRatio("Left Arm",Vector3.new(1,2,1))
	        addRatio("Right Arm",Vector3.new(1,2,1))
	        addRatio("Left Leg",Vector3.new(1,2,1))
	        addRatio("Right Leg",Vector3.new(1,2,1))
	    else
	        addRatio("HumanoidRootPart",Vector3.new(2,2,1))
	        addRatio("Head",Vector3.new(2,1,1))
	        local upper=model:FindFirstChild("UpperTorso",true)
	        if upper and upper:IsA("BasePart") and upper.Size.X>0 then
	            ratios[#ratios+1]=upper.Size.X/2
	        end
	    end

	    if #ratios==0 then return 1 end
	    table.sort(ratios)
	    local mid
	    if #ratios%2==1 then
	        mid=ratios[(#ratios+1)/2]
	    else
	        mid=(ratios[#ratios/2]+ratios[#ratios/2+1])/2
	    end

	    if mid<=1.20 then return 1 end
	    local factor=1/mid

	    local pivot=model:FindFirstChild("HumanoidRootPart",true)
	        or model:FindFirstChild("Torso",true)
	        or model:FindFirstChild("UpperTorso",true)
	        or model:FindFirstChildWhichIsA("BasePart",true)
	    if not pivot or not pivot:IsA("BasePart") then return 1 end

	    local pivotCF=pivot.CFrame

	    local function scaleCFTranslation(cf,k)
	        local pos=cf.Position*k
	        local rot=cf-cf.Position
	        return CFrame.new(pos)*rot
	    end

	    for _,x in ipairs(model:GetDescendants()) do
	        if x:IsA("BasePart") then
	            local rel=pivotCF:ToObjectSpace(x.CFrame)
	            local pos=rel.Position*factor
	            local rot=rel-rel.Position
	            x.CFrame=pivotCF*CFrame.new(pos)*rot
	            x.Size=x.Size*factor

	        elseif x:IsA("Attachment") then
	            x.Position=x.Position*factor

	        elseif x:IsA("SpecialMesh") then

	            if x.MeshType==Enum.MeshType.FileMesh then
	                x.Scale=x.Scale*factor
	            end
	            x.Offset=x.Offset*factor

	        elseif x:IsA("FileMesh") then

	            x.Scale=x.Scale*factor
	            x.Offset=x.Offset*factor

	        elseif x:IsA("BlockMesh") or x:IsA("CylinderMesh") then

	            x.Offset=x.Offset*factor

	        elseif x:IsA("Motor6D") or x:IsA("Weld") or x:IsA("ManualWeld") or x:IsA("Snap") then
	            x.C0=scaleCFTranslation(x.C0,factor)
	            x.C1=scaleCFTranslation(x.C1,factor)
	        end
	    end

	    return factor
	end

