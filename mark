				accent = Color3.fromRGB(255, 255, 255),
			}

			local HudTS = game:GetService("TweenService")
			local gui, markRoot, keyRoot
			local chips, keyRows = {}, {}
			local chipIcons = {}
			local frames, fps, fpsAt = 0, 0, os.clock()

			local function plate(parent, order, padX, gap)
				local card = Instance.new("Frame")
				card.Size = UDim2.fromOffset(0, 30)
				card.AutomaticSize = Enum.AutomaticSize.X
				card.BackgroundColor3 = TH.panel
				card.BackgroundTransparency = 0.16
				card.BorderSizePixel = 0
				card.LayoutOrder = order
				card.ZIndex = 2
				card.Parent = parent
				Instance.new("UICorner", card).CornerRadius = UDim.new(0, 8)

				-- the library's stacked-stroke halo, same one its notifications
				-- use, so the plate separates from whatever is behind it
				pcall(function()
					NeverLose:CreateShadow(card, false):Render(true)
				end)

				local edge = Instance.new("UIStroke")
				edge.Color = TH.line
				edge.Thickness = 1
				edge.Transparency = 0.45
				edge.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
				edge.LineJoinMode = Enum.LineJoinMode.Round
				edge.Parent = card

				local skin = Instance.new("Frame")
				skin.Size = UDim2.fromScale(1, 1)
				skin.BackgroundColor3 = TH.glow
				skin.BackgroundTransparency = 0.82
				skin.BorderSizePixel = 0
				skin.ZIndex = 2
				skin.Parent = card
				Instance.new("UICorner", skin).CornerRadius = UDim.new(0, 8)
				local skinGrad = Instance.new("UIGradient")
				skinGrad.Rotation = 90
				skinGrad.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.5),
					NumberSequenceKeypoint.new(0.6, 0.82),
					NumberSequenceKeypoint.new(1, 0.9),
				})
				skinGrad.Parent = skin

				local gloss = Instance.new("Frame")
				gloss.AnchorPoint = Vector2.new(0.5, 0)
				gloss.Position = UDim2.new(0.5, 0, 0, 1)
				gloss.Size = UDim2.new(1, -14, 0, 1)
				gloss.BackgroundColor3 = TH.glow
				gloss.BackgroundTransparency = 0.7
				gloss.BorderSizePixel = 0
				gloss.ZIndex = 3
				gloss.Parent = card
				local glossGrad = Instance.new("UIGradient")
				glossGrad.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(0.5, 0.1),
					NumberSequenceKeypoint.new(1, 1),
				})
				glossGrad.Parent = gloss

				local hold = Instance.new("Frame")
				hold.Size = UDim2.fromOffset(0, 30)
				hold.AutomaticSize = Enum.AutomaticSize.X
				hold.BackgroundTransparency = 1
				hold.BorderSizePixel = 0
				hold.ZIndex = 3
				hold.Parent = card
				local pad = Instance.new("UIPadding")
				pad.PaddingLeft, pad.PaddingRight = UDim.new(0, padX), UDim.new(0, padX)
				pad.Parent = hold
				local ll = Instance.new("UIListLayout")
				ll.FillDirection = Enum.FillDirection.Horizontal
				ll.VerticalAlignment = Enum.VerticalAlignment.Center
				ll.SortOrder = Enum.SortOrder.LayoutOrder
				ll.Padding = UDim.new(0, gap or 8)
				ll.Parent = hold

				return card, hold
			end

			local function glyph(parent, name, order)
				local g = Instance.new("TextLabel")
				g.Size = UDim2.fromOffset(17, 17)
				g.BackgroundTransparency = 1
				g.FontFace = NeverLose.BuiltInBold
				g.Text = name
				g.TextColor3 = TH.dim
				g.TextSize = 15
				g.LayoutOrder = order
				g.ZIndex = 4
				g.Parent = parent
				return g
			end

			local function text(parent, str, order, colour, size)
				local t = Instance.new("TextLabel")
				t.AutomaticSize = Enum.AutomaticSize.X
				t.Size = UDim2.fromOffset(0, 20)
				t.BackgroundTransparency = 1
				t.Font = Enum.Font.GothamMedium
				t.Text = str
				t.TextColor3 = colour or TH.text
				t.TextSize = size or 14
				t.TextTransparency = 0.05
				t.LayoutOrder = order
				t.ZIndex = 4
				t.Parent = parent
				return t
			end

			local function drag(handle, root)
				local held, grabAt, startPos = false, nil, nil
				handle.Active = true
				handle.InputBegan:Connect(function(i)
					if i.UserInputType ~= Enum.UserInputType.MouseButton1
						and i.UserInputType ~= Enum.UserInputType.Touch then return end
					held, grabAt, startPos = true, i.Position, root.Position
				end)
				handle.InputEnded:Connect(function(i)
					if i.UserInputType == Enum.UserInputType.MouseButton1
						or i.UserInputType == Enum.UserInputType.Touch then held = false end
				end)
				tc(UIS.InputChanged:Connect(function(i)
					if not held or not root.Parent then return end
					if i.UserInputType ~= Enum.UserInputType.MouseMovement
						and i.UserInputType ~= Enum.UserInputType.Touch then return end
					local d = i.Position - grabAt
					root.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
						startPos.Y.Scale, startPos.Y.Offset + d.Y)
				end))
			end

			local function build()
				if gui and gui.Parent then return end
				gui = Instance.new("ScreenGui")
				gui.Name = "NL_HUD"
				gui.ResetOnSpawn = false
				gui.IgnoreGuiInset = true
				gui.DisplayOrder = 900
				gui.Parent = (gethui and gethui()) or NeverLose.ScreenGui.Parent

				markRoot = Instance.new("Frame")
				markRoot.Name = "Watermark"
				markRoot.AnchorPoint = Vector2.new(1, 0)
				markRoot.Position = UDim2.new(1, -8, 0, 8)
				markRoot.Size = UDim2.fromOffset(0, 0)
				markRoot.AutomaticSize = Enum.AutomaticSize.XY
				markRoot.BackgroundTransparency = 1
				markRoot.ZIndex = 900
				markRoot.Parent = gui
				local ml = Instance.new("UIListLayout")
				ml.FillDirection = Enum.FillDirection.Horizontal
				ml.HorizontalAlignment = Enum.HorizontalAlignment.Right
				ml.VerticalAlignment = Enum.VerticalAlignment.Center
				ml.SortOrder = Enum.SortOrder.LayoutOrder
				ml.Padding = UDim.new(0, 8)
				ml.Parent = markRoot

				local badge, badgeHold = plate(markRoot, 1, 13, 8)
				glyph(badgeHold, "code", 1)
				local wordmark = text(badgeHold, "salad", 2)

				-- a slow highlight travelling across the wordmark, so the plate
				-- has some life without anything blinking
				local sweep = Instance.new("UIGradient")
				sweep.Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, TH.text),
					ColorSequenceKeypoint.new(0.5, Color3.fromRGB(120, 170, 255)),
					ColorSequenceKeypoint.new(1, TH.text),
				})
				sweep.Parent = wordmark
				task.spawn(function()
					while wordmark.Parent do
						sweep.Offset = Vector2.new((os.clock() * 0.25 % 2) - 1, 0)
						task.wait(1 / 30)
					end
				end)
				drag(badge, markRoot)

				local function chip(order, icon, initial, width)
					local card, hold = plate(markRoot, order, 13, 8)
					local ico = icon and glyph(hold, icon, 1) or nil
					local lbl = text(hold, initial, 2)
					if width then
						lbl.AutomaticSize = Enum.AutomaticSize.None
						lbl.Size = UDim2.fromOffset(width, 20)
						lbl.TextXAlignment = Enum.TextXAlignment.Left
					end
					drag(card, markRoot)
					return lbl, ico
				end

				chips.who  = chip(2, "person", LP.Name)
				-- Roblox instances reject stray fields, so the icons live beside
				-- their labels in a side table
				chips.fps,  chipIcons.fps  = chip(3, "chart-line", "0", 30)
				chips.ping, chipIcons.ping = chip(4, "signal-exclamation", "0ms", 44)
				chips.time = chip(5, "arrow-spin-clockwise", "00:00", 40)

				keyRoot = Instance.new("Frame")
				keyRoot.Name = "Hotkeys"
				keyRoot.AnchorPoint = Vector2.new(0, 0.5)
				keyRoot.Position = UDim2.new(0, 8, 0.5, 0)
				keyRoot.Size = UDim2.fromOffset(0, 0)
				keyRoot.AutomaticSize = Enum.AutomaticSize.XY
				keyRoot.BackgroundTransparency = 1
				keyRoot.ZIndex = 900
				keyRoot.Parent = gui
				local kl = Instance.new("UIListLayout")
				kl.FillDirection = Enum.FillDirection.Vertical
				kl.HorizontalAlignment = Enum.HorizontalAlignment.Left
				kl.SortOrder = Enum.SortOrder.LayoutOrder
				kl.Padding = UDim.new(0, 3)
				kl.Parent = keyRoot

				local crown, crownHold = plate(keyRoot, 0, 14, 8)
				glyph(crownHold, "key", 1)
				text(crownHold, "hotkeys", 2)
				drag(crown, keyRoot)
			end

			local function teardown()
				if gui then pcall(function() gui:Destroy() end) end
				gui, markRoot, keyRoot = nil, nil, nil
				chips = {}
				table.clear(chipIcons)
				keyRows = {}
			end
			S._ClearHud = teardown

			local function perch(name, key, order)
				local row = keyRows[name]
				if not row then
					local holder = Instance.new("CanvasGroup")
					holder.Size = UDim2.fromOffset(0, 36)
					holder.AutomaticSize = Enum.AutomaticSize.X
					holder.BackgroundTransparency = 1
					holder.ZIndex = 2
					holder.Parent = keyRoot
					local rl = Instance.new("UIListLayout")
					rl.FillDirection = Enum.FillDirection.Horizontal
					rl.VerticalAlignment = Enum.VerticalAlignment.Center
					rl.SortOrder = Enum.SortOrder.LayoutOrder
					rl.Padding = UDim.new(0, 5)
					rl.Parent = holder

					local pill = plate(holder, 1, nil, nil)
					pill.AutomaticSize = Enum.AutomaticSize.None
					pill.Size = UDim2.fromOffset(32, 32)
					local rail = Instance.new("Frame")
					rail.AnchorPoint = Vector2.new(0.5, 0.5)
					rail.Position = UDim2.fromScale(0.5, 0.5)
					rail.Size = UDim2.fromOffset(24, 13)
					rail.BackgroundColor3 = TH.bg
					rail.BorderSizePixel = 0
					rail.ZIndex = 4
					rail.Parent = pill
					Instance.new("UICorner", rail).CornerRadius = UDim.new(1, 0)
					local bead = Instance.new("Frame")
					bead.AnchorPoint = Vector2.new(0.5, 0.5)
					bead.Position = UDim2.new(0.3, 0, 0.5, 0)
					bead.Size = UDim2.fromOffset(9, 9)
					bead.BackgroundColor3 = Color3.new(1, 1, 1)
					bead.BackgroundTransparency = 0.45
					bead.BorderSizePixel = 0
					bead.ZIndex = 5
					bead.Parent = rail
					Instance.new("UICorner", bead).CornerRadius = UDim.new(1, 0)
					local beadGlow = Instance.new("UIStroke")
					beadGlow.Color = TH.accent
					beadGlow.Thickness = 2
					beadGlow.Transparency = 1
					beadGlow.Parent = bead

					local _, nameHold = plate(holder, 2, 14, 10)
					local nameLbl = text(nameHold, name, 1)

					local _, keyHold = plate(holder, 3, 12, 0)
					local keyLbl = text(keyHold, key, 1, TH.accent)
					keyLbl.TextTransparency = 0.1

					holder.GroupTransparency = 1
					row = { holder = holder, rail = rail, bead = bead,
						beadGlow = beadGlow, nameLbl = nameLbl, keyLbl = keyLbl,
						-- the holder is created at GroupTransparency 1, so this has
						-- to start at 1 too or the first pass sees no change to
						-- make and the row never fades in
						lit = nil, fade = 1 }
					keyRows[name] = row
				end
				row.holder.LayoutOrder = order
				row.holder.Visible = true
				if row.keyLbl.Text ~= key then row.keyLbl.Text = key end
				row.seen = true

				-- the switch follows the feature instead of sitting still
				local tgl = S.BindToggles and S.BindToggles[name]
				local lit = tgl and tgl:GetValue() == true or false
				if row.lit ~= lit then
					row.lit = lit
					local ease = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
					HudTS:Create(row.bead, ease, {
						Position = UDim2.new(lit and 0.7 or 0.3, 0, 0.5, 0),
						BackgroundTransparency = lit and 0 or 0.5,
					}):Play()
					HudTS:Create(row.rail, ease, {
						BackgroundColor3 = lit and TH.accent or TH.bg,
						BackgroundTransparency = lit and 0.72 or 0,
					}):Play()
					HudTS:Create(row.beadGlow, ease, { Transparency = lit and 0.35 or 1 }):Play()
					HudTS:Create(row.nameLbl, ease, {
						TextTransparency = lit and 0 or 0.4,
					}):Play()
				end
				return row
			end

			tc(RunService.RenderStepped:Connect(function()
				if not (S.HudWatermark or S.HudBinds) then
					if gui then teardown() end
					return
				end
				build()
				if not (markRoot and keyRoot) then return end

				frames = frames + 1
				local now = os.clock()

				markRoot.Visible = S.HudWatermark == true
				if S.HudWatermark and now - fpsAt >= 0.5 then
					fps = math.floor(frames / (now - fpsAt) + 0.5)
					frames, fpsAt = 0, now
					local ping = 0
					pcall(function()
						ping = math.floor(game:GetService("Stats")
							.Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5)
					end)
					chips.fps.Text  = tostring(fps)
					chips.ping.Text = tostring(ping) .. "ms"
					-- colour says how it is doing before the number is read
					chips.fps.TextColor3 = (fps >= 100 and Color3.fromRGB(126, 224, 150))
						or (fps >= 45 and Color3.fromRGB(240, 208, 120))
						or Color3.fromRGB(240, 118, 118)
					chips.ping.TextColor3 = (ping <= 90 and Color3.fromRGB(126, 224, 150))
						or (ping <= 180 and Color3.fromRGB(240, 208, 120))
						or Color3.fromRGB(240, 118, 118)
					if chipIcons.fps then
						chipIcons.fps.TextColor3 = chips.fps.TextColor3
					end
					if chipIcons.ping then
						chipIcons.ping.TextColor3 = chips.ping.TextColor3
					end
					chips.time.Text = os.date("%H:%M")
					if chips.who.Text ~= LP.Name then chips.who.Text = LP.Name end
				elseif not S.HudWatermark then
					frames, fpsAt = 0, now
				end

				keyRoot.Visible = S.HudBinds == true
				if S.HudBinds then
					for _, r in pairs(keyRows) do r.seen = false end
					local names = {}
					for name, b in pairs(S.Binds or {}) do
						-- a mouse bind has .mouse and no .key; the old test dropped it
						if b and (b.key or b.mouse) then names[#names + 1] = name end
					end
					table.sort(names)
					for i, name in ipairs(names) do
						local b = S.Binds[name]
						local shown
						if b.key then
							shown = b.key.Name
						elseif b.mouse == Enum.UserInputType.MouseButton1 then
							shown = "MB1"
						elseif b.mouse == Enum.UserInputType.MouseButton2 then
							shown = "MB2"
						else
							shown = "?"
						end
						perch(name, shown, i)
					end
					for _, r in pairs(keyRows) do
						local want = r.seen and 0 or 1
						if r.fade ~= want then
							r.fade = want
							HudTS:Create(r.holder,
								TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
								{ GroupTransparency = want }):Play()
							if want == 1 then
								task.delay(0.15, function()
									if r.holder and r.holder.Parent and r.fade == 1 then
										r.holder.Visible = false
									end
								end)
							end
						end
					end
				end
			end))
		end

		secHudS:AddLabel("Watermark"):AddToggle({
			Default = false, Callback = function(v) S.HudWatermark = v end,
		})
		secHudS:AddLabel("Keybind List"):AddToggle({
			Default = false, Callback = function(v) S.HudBinds = v end,
		})
	end

	do
		local Accent = NeverLose.AccentColor;
		local TS = game:GetService("TweenService");

		local secAnimPack = PlayerTab:AddSection({ Name = "Animation Pack", Position = "left" });
		local secEmote    = PlayerTab:AddSection({ Name = "Emotes", Position = "right" });

		local COLS       = 2
		local CELL_H     = 116
		local PAD        = 8
		local COL_IDLE   = Color3.fromRGB(25, 27, 33)
		local COL_HOVER  = Color3.fromRGB(35, 38, 48)
		local COL_ACTIVE = Color3.fromRGB(30, 34, 48)
		local COL_TEXT   = Color3.fromRGB(236, 238, 244)
		local COL_EDGE   = Color3.fromRGB(45, 48, 58)

		local function loom(parent, height, order, cfg)
			local sf = Instance.new("ScrollingFrame")
			sf.Size = UDim2.new(1, -8, 0, height)
			sf.BackgroundColor3 = Color3.fromRGB(13, 14, 18)
			sf.BackgroundTransparency = 0
			sf.ZIndex = 20
			sf.BorderSizePixel = 0
			sf.ScrollBarThickness = 4
			sf.ScrollBarImageColor3 = Accent
			sf.CanvasSize = UDim2.new()
			sf.ClipsDescendants = true
			sf.Parent = parent
			sf.LayoutOrder = order
			Instance.new("UICorner", sf).CornerRadius = UDim.new(0, 6)

			local pool, live = {}, {}
			local selectedKey = nil
			local pulse

			local function build()
				local card = Instance.new("TextButton")
				card.BackgroundColor3 = COL_IDLE
				card.BorderSizePixel = 0
				card.ZIndex = 21
				card.AutoButtonColor = false
				card.Text = ""
				Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)

				local stroke = Instance.new("UIStroke")
				stroke.Color = COL_EDGE
				stroke.Thickness = 1
				stroke.Transparency = 0.45
				stroke.Parent = card

				local img = Instance.new("ImageLabel")
				img.Name = "Thumb"
				img.ZIndex = 22
				img.BackgroundTransparency = 1
				img.ScaleType = Enum.ScaleType.Fit
				img.Parent = card
				Instance.new("UICorner", img).CornerRadius = UDim.new(0, 4)

				local lbl = Instance.new("TextLabel")
				lbl.Name = "Title"
				lbl.ZIndex = 23
				lbl.BackgroundTransparency = 1
				lbl.TextColor3 = COL_TEXT
				lbl.Font = Enum.Font.GothamMedium
				lbl.TextSize = 11
				lbl.TextTruncate = Enum.TextTruncate.AtEnd
				lbl.Parent = card

				local star = Instance.new("TextLabel")
				star.Name = "Fav"
				star.ZIndex = 24
				star.AnchorPoint = Vector2.new(0, 0)
				star.Position = UDim2.fromOffset(5, 4)
				star.Size = UDim2.fromOffset(16, 16)
				star.BackgroundTransparency = 1
				star.Text = "star"
				star.FontFace = NeverLose.BuiltInBold
				star.TextColor3 = Color3.fromRGB(236, 238, 244)
				star.TextSize = 14
				star.Visible = false
				star.Parent = card

				local dot = Instance.new("Frame")
				dot.Name = "ActiveDot"
				dot.ZIndex = 24
				dot.AnchorPoint = Vector2.new(1, 0)
				dot.Position = UDim2.new(1, -6, 0, 6)
				dot.Size = UDim2.fromOffset(7, 7)
				dot.BorderSizePixel = 0
				dot.Visible = false
				dot.Parent = card
				Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

				local t = { card = card, img = img, lbl = lbl, stroke = stroke, dot = dot, star = star }
				card.MouseEnter:Connect(function()
					if t.key ~= selectedKey then card.BackgroundColor3 = COL_HOVER end
				end)
				card.MouseLeave:Connect(function()
					if t.key ~= selectedKey then card.BackgroundColor3 = COL_IDLE end
				end)
				card.MouseButton1Click:Connect(function()
					if not t.entry then return end
					pulse(t)
					task.spawn(function() cfg.onClick(t.entry, t.key) end)
				end)
				card.MouseButton2Click:Connect(function()
					if not t.entry or not cfg.onFav then return end
					cfg.onFav(t.entry, t.key)
				end)
				return t
			end

			local function paint(t)
				local on = (t.key ~= nil and t.key == selectedKey)
				t.card.BackgroundColor3 = on and COL_ACTIVE or COL_IDLE
				t.stroke.Color = on and Accent or COL_EDGE
				t.stroke.Thickness = on and 2 or 1
				t.stroke.Transparency = on and 0 or 0.45
				t.lbl.TextColor3 = on and Accent or COL_TEXT
				t.dot.Visible = on
				if on then t.dot.BackgroundColor3 = Accent end
			end

			function pulse(t)
				local ring = Instance.new("Frame")
				ring.AnchorPoint = Vector2.new(0.5, 0.5)
				ring.Position = UDim2.fromScale(0.5, 0.5)
				ring.Size = UDim2.fromScale(1, 1)
				ring.BackgroundTransparency = 1
				ring.ZIndex = 25
				ring.Parent = t.card
				Instance.new("UICorner", ring).CornerRadius = UDim.new(0, 6)
				local rs = Instance.new("UIStroke")
				rs.Color = Accent
				rs.Thickness = 2
				rs.Transparency = 0.1
				rs.Parent = ring
				local info = TweenInfo.new(0.42, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
				TS:Create(ring, info, { Size = UDim2.fromScale(1.22, 1.18) }):Play()
				TS:Create(rs, info, { Transparency = 1, Thickness = 0.5 }):Play()
				game:GetService("Debris"):AddItem(ring, 0.55)
			end

			local grid = {}

			function grid.refresh()
				local list = cfg.getList() or {}
				local total = #list
				local rows = math.ceil(total / COLS)
				local rowH = CELL_H + PAD

				local wantCanvas = math.max(0, rows * rowH + PAD)
				if sf.CanvasSize.Y.Offset ~= wantCanvas then
					sf.CanvasSize = UDim2.new(0, 0, 0, wantCanvas)
				end

				local usable = sf.AbsoluteSize.X - sf.ScrollBarThickness - PAD * (COLS + 1)
				local cellW = math.max(60, usable / COLS)

				local top = sf.CanvasPosition.Y
				local viewH = sf.AbsoluteSize.Y
				if viewH <= 0 then viewH = height end

				local firstRow = math.max(0, math.floor((top - PAD) / rowH) - 1)
				local lastRow = math.min(rows - 1, math.floor((top + viewH) / rowH) + 1)

				local want = {}
				for r = firstRow, lastRow do
					for c = 0, COLS - 1 do
						local i = r * COLS + c + 1
						if i >= 1 and i <= total then want[i] = { r, c } end
					end
				end

				for i, t in pairs(live) do
					if not want[i] then
						t.card.Visible = false
						t.entry, t.key = nil, nil
						pool[#pool + 1] = t
						live[i] = nil
					end
				end

				for i, rc in pairs(want) do
					local t = live[i]
					if not t then
						t = table.remove(pool) or build()
						t.card.Parent = sf
						live[i] = t
					end
					local entry = list[i]
					t.entry = entry
					t.key = cfg.keyOf(entry)
					t.card.Visible = true
					t.card.Size = UDim2.fromOffset(cellW, CELL_H)
					t.card.Position = UDim2.fromOffset(
						PAD + rc[2] * (cellW + PAD),
						PAD + rc[1] * rowH)
					t.img.Size = UDim2.new(1, -16, 0, CELL_H - 44)
					t.img.Position = UDim2.fromOffset(8, 8)
					t.lbl.Size = UDim2.new(1, -10, 0, 22)
					t.lbl.Position = UDim2.fromOffset(5, CELL_H - 30)
					if t.star and cfg.isFav then t.star.Visible = cfg.isFav(entry) == true end
					local url = cfg.imageOf(entry)
					local sized = sf.AbsoluteSize.X > 0
					if t.img.Image ~= url or t.imgKey ~= t.key or not t.imgSized then
						t.img.Image = url
						t.imgKey = t.key
						t.imgSized = sized
					end
					t.lbl.Text = cfg.nameOf(entry)
					paint(t)
				end
			end

			function grid.select(key)
				selectedKey = key
				for _, t in pairs(live) do paint(t) end
			end

			NeverLose:AddSignal(sf:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
				if sf.AbsoluteSize.X > 0 then
					task.defer(function() pcall(grid.refresh) end)
				end
			end))

			local dirty, running = false, false
			local function queue()
				dirty = true
				if running then return end
				running = true
				task.spawn(function()
					while dirty do
						dirty = false
						local ok, err = pcall(grid.refresh)
						if not ok then warn("[grid] " .. tostring(err)) end
						RunService.Heartbeat:Wait()
					end
					running = false
				end)
			end
			grid.queue = queue

			sf:GetPropertyChangedSignal("CanvasPosition"):Connect(queue)
			sf:GetPropertyChangedSignal("AbsoluteSize"):Connect(queue)

			local parked = {}
			sf.MouseEnter:Connect(function()
				local a = sf.Parent
				while a and not a:IsA("ScreenGui") do
					if a:IsA("ScrollingFrame") and a.ScrollingEnabled then
						parked[#parked + 1] = a
						a.ScrollingEnabled = false
					end
					a = a.Parent
				end
			end)
			sf.MouseLeave:Connect(function()
				for i = #parked, 1, -1 do
					if parked[i] and parked[i].Parent then parked[i].ScrollingEnabled = true end
					parked[i] = nil
				end
			end)

			return grid
		end

		do
			secAnimPack:AddLabel("Search"):AddTextInput({
				Placeholder = "Search packs...",
				Callback = function(v)
					S.PackSearch = v
					S._RefreshPackList()
					if S._PackGrid then S._PackGrid.queue() end
				end,
			})

			local grid
			grid = loom(secAnimPack.Root, 430, 10, {
				getList = function() return S.PackFiltered end,
				keyOf   = function(e) return e.name end,
				nameOf  = function(e) return e.name end,
				imageOf = function(e)
					return "rbxthumb://type=BundleThumbnail&id=" .. e.id .. "&w=420&h=420"
				end,
				onClick = function(entry, key)
					S.PackName = entry.name
					S.ApplyPack(entry.name)
					grid.select(key)
				end,
				isFav = function(e) return (S.PackFavs or {})[e.name] == true end,
				onFav = function(e)
					S.PackFavs = S.PackFavs or {}
					S.PackFavs[e.name] = (not S.PackFavs[e.name]) or nil
					S._RefreshPackList()
					grid.queue()
				end,
			})
			S._PackGrid = grid
			S._BuildPackGrid = grid.refresh

			local resetBtn = secAnimPack:AddButton({ Name = "Reset Pack", Icon = "arrow-rotate-right", Callback = function()
				S.PackName = "Default"
				S.ApplyPack("Default")
				grid.select(nil)
			end })
			if resetBtn and resetBtn.Root then resetBtn.Root.LayoutOrder = 1 end

			task.spawn(function()
				for _ = 1, 120 do
					if #(S.PackCatalog or {}) > 0 then break end
					task.wait(0.5)
				end
				S._RefreshPackList()
				grid.refresh()
			end)
		end

		do
			secEmote:AddLabel("Loop Emote"):AddToggle({
				Default = false,
				Callback = function(v)
					if S._SetEmoteLoop then S._SetEmoteLoop(v) else S.EmoteLoop = v end
				end,
			})

			secEmote:AddLabel("Search"):AddTextInput({
				Placeholder = "Search emotes...",
				Callback = function(v)
					S.EmoteSearch = v
					S._refreshEmoteList()
					if S._EmoteGrid then S._EmoteGrid.queue() end
				end,
			})

			local grid
			grid = loom(secEmote.Root, 430, 60, {
				getList = function() return S._emoteFilteredList end,
				keyOf   = function(e) return e.id end,
				nameOf  = function(e) return e.name end,
				imageOf = function(e)
					return "rbxthumb://type=Asset&id=" .. e.id .. "&w=420&h=420"
				end,
				onClick = function(entry, key)
					grid.select(key)
					S.PlayEmote(entry.id)
				end,
				isFav = function(e) return S.EmoteFavorites[e.id] == true end,
				onFav = function(e)
					S.EmoteFavorites[e.id] = (not S.EmoteFavorites[e.id]) or nil
					S._refreshEmoteList()
					grid.queue()
				end,
			})
			S._EmoteGrid = grid
			S._buildEmoteGrid = grid.refresh

			task.spawn(function()
				for _ = 1, 120 do
					if #S.EmoteCatalog > 0 then break end
					task.wait(0.5)
				end
				S._refreshEmoteList()
				grid.refresh()
			end)
		end
	end

end
end

return NeverLose;
