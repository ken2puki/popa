			local beam = Instance.new("Beam")
			beam.FaceCamera = true
			beam.TextureSpeed = st.speed
			beam.TextureLength = st.len
			beam.Width0 = st.width
			beam.Width1 = st.tail or st.width
			beam.LightEmission = st.emission
			beam.LightInfluence = 0
			beam.Brightness = st.brightness
			beam.Color = ColorSequence.new(S.TracerColor)
			-- feather both ends: a beam that starts and stops at full opacity
			-- reads as a drawn line, not as a shot passing through
			beam.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.08, st.alpha0),
				NumberSequenceKeypoint.new(0.92, st.alpha1),
				NumberSequenceKeypoint.new(1, 1),
			})
			beam.Attachment0 = start_part.Attachment
			beam.Attachment1 = end_part.Attachment
			beam.Parent = start_part

			task.delay(duration, function()
				if beam.Parent then
					-- Beam.Transparency is a sequence and cannot be tweened, so
					-- the dissolve rides on brightness and emission instead of
					-- the beam pinching to a thread at full glow
					TweenSvc:Create(beam, fade_tween, {
						Width0 = 0,
						Width1 = 0,
						Brightness = 0,
						LightEmission = 0,
					}):Play()
				end
			end)
		end

		local function screen_tracer(start_value, end_value)
			local a = to_position(start_value)
			local b = to_position(end_value)
			if not (a and b) then return end
			if not Drawing then return end

			local st = STYLES[S.TracerStyle]
			local core_w = math.clamp((st and st.width or 0.25) * 8, 1, 6)

			-- a dark pass under the bright one: the streak keeps its shape against
			-- pale walls and sky instead of washing out. Optional: if it cannot
			-- be made, the tracer still draws without its shadow.
			local glow
			pcall(function()
				glow = Drawing.new("Line")
				glow.Thickness = core_w + 3
				glow.Color = Color3.fromRGB(8, 8, 12)
				glow.Transparency = 0.45
				glow.ZIndex = 999
				glow.Visible = false
			end)

			local line = Drawing.new("Line")
			line.Thickness = core_w
			line.Color = S.TracerColor
			line.Transparency = 1
			line.ZIndex = 1000
			line.Visible = false

			local born = os.clock()
			local conn
			conn = RunService.RenderStepped:Connect(function()
				local cam = workspace.CurrentCamera
				local life = tonumber(S.TracerDuration) or 1
				local age = os.clock() - born
				if not cam or age > life or not S.Tracers then
					pcall(function() line:Remove() end)
					if glow then pcall(function() glow:Remove() end) end
					if conn then conn:Disconnect() end
					return
				end
				local p1, on1 = cam:WorldToViewportPoint(a)
				local p2, on2 = cam:WorldToViewportPoint(b)
				if not (on1 or on2) then
					line.Visible = false
					if glow then glow.Visible = false end
					return
				end
				local from = Vector2.new(p1.X, p1.Y)
				local to = Vector2.new(p2.X, p2.Y)
				line.From, line.To = from, to
				if glow then glow.From, glow.To = from, to end
				line.Color = S.TracerColor

				-- smoothstep: bright for a moment, then a soft dissolve rather
				-- than the hard cut the old cliff at two thirds gave
				local t = math.clamp(age / life, 0, 1)
				local k = 1 - (t * t * (3 - 2 * t))
				line.Transparency = k
				line.Thickness = math.max(1, core_w * (0.55 + 0.45 * k))
				line.Visible = true
				if glow then
					glow.Transparency = k * 0.45
					glow.Thickness = line.Thickness + 3
					glow.Visible = true
				end
			end)
			tc(conn)
		end

		S._DrawTracer = function(a, b)
			if S.TracerWalls then screen_tracer(a, b) else styled_tracer(a, b) end
		end

		local function on_gun_fired(gun, start_value, end_value, mine)
			if not S.Tracers then return end
			if S.TracerSelfOnly then
				if not mine then return end
				if not is_local_sheriff() then return end
			end
			if S.TracerWalls then
				screen_tracer(start_value, end_value)
			else
				styled_tracer(start_value, end_value)
			end
		end
		S._OnGunFiredTracer = on_gun_fired
	end

