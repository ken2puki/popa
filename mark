	local function roleMap()
		local map = {}
		local pd = CRC and rawget(CRC, "PlayerData")
		if type(pd) == "table" then
			for name, d in pairs(pd) do
				if type(d) == "table" and d.Role then

					if not ((d.Role == "Sheriff" or d.Role == "Hero") and d.Dead) then
						map[name] = d.Role
					end
				end
			end
		end
		for _, p in ipairs(Players:GetPlayers()) do
			local c  = p.Character
			local bp = p:FindFirstChildOfClass("Backpack")
			local function has(cont, n) return cont and cont:FindFirstChild(n) end
			local hasGun = has(c, "Gun") or has(bp, "Gun")
				or has(c, "Revolver") or has(bp, "Revolver")
			local hasKnife = has(c, "Knife") or has(c, "KnifeServer")
				or has(bp, "Knife") or has(bp, "KnifeServer")

			-- knife first: it is the one item only the murderer carries, and
			-- the murderer can be holding the gun as well once the sheriff is
			-- down. Checking the gun first labelled them Sheriff.
			if hasKnife then
				map[p.Name] = "Murderer"
			elseif hasGun and map[p.Name] ~= "Murderer" then
				map[p.Name] = (map[p.Name] == "Hero") and "Hero" or "Sheriff"
			end
		end
		return map
	end

