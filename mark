	do
		local ESP_PATH = "SaladAssets/esp.lua"
		S.ESP = false
		S.ESPLib = nil

		-- every other asset pulls itself on first use; the ESP library was the
		-- one that expected to already be on disk. esp.lua lives at the repo
		-- root beside salad.lua, and salad.lua is served as /salad, so the
		-- exact served path is not obvious -- try the candidates in order.
		local ESP_URLS = {
			"https://inertiahub.xyz/esp.lua",
			"https://inertiahub.xyz/esp",
			"https://inertiahub.xyz/assets/esp.lua",
		}
		local espPulled = false

		local function pullLib()
			if espPulled then return end
			espPulled = true
			if not (writefile and isfolder and makefolder) then return end
			pcall(function()
				if not isfolder("SaladAssets") then makefolder("SaladAssets") end
			end)
			for _, url in ipairs(ESP_URLS) do
				local ok, body = pcall(function() return game:HttpGet(url) end)
				-- check it is the library and not a 404 page, or the error page
				-- gets cached to disk and every later load reads that instead
				if ok and type(body) == "string" and #body > 256
					and body:find("Load", 1, true) then
					if pcall(function() writefile(ESP_PATH, body) end) then return end
				end
			end
		end

		local function getLib()
			if S.ESPLib then return S.ESPLib end
			if not (isfile and isfile(ESP_PATH)) then
				pullLib()
				if not (isfile and isfile(ESP_PATH)) then return nil end
			end
			local ok, lib = pcall(function()
				local fn = loadstring(readfile(ESP_PATH))
				return fn and fn() or nil
			end)
			if ok and type(lib) == "table" and type(lib.Load) == "function" then
				S.ESPLib = lib
				return lib
			end
			return nil
		end
		S._ESPLib = getLib

		local function feedRoles()
			local lib = S.ESPLib
			if not lib then return end
			-- this used to build its own map from a gun check alone, which is
			-- the same defect fixed in roleMap: a murderer carrying the gun was
			-- handed to the ESP as Sheriff and drew in the wrong colour. Use
			-- the shared map rather than keeping a second, worse copy.
			local shared = S.RoleMap and S.RoleMap() or nil
			local map = {}
			if type(shared) == "table" then
				for name, role in pairs(shared) do
					-- the ESP has no Hero colour of its own
					map[name] = (role == "Hero") and "Sheriff" or role
				end
			end
			lib.roles = map
		end

		S._SetESP = function(on)
			local lib = getLib()
			if not lib then return false end
			S.ESP = on
			lib.tSet.en.en = on

			local en = lib.tSet.en
			en.boxO, en.boxF, en.boxGrd = true, false, false
			en.chams, en.hb, en.ht, en.wep = false, false, false, false
			if on then
				feedRoles()
				pcall(lib.Load)
			else
				pcall(lib.Unload)
			end
			return true
		end

		S._ESPSet = function(key, value)
			local lib = getLib()
			if not lib then return end
			lib.tSet.en[key] = value
		end

		S._ESPAt = 0
		tc(RunService.Heartbeat:Connect(function()
			if not S.ESP or not S.ESPLib then return end
			local now = os.clock()
			if now - S._ESPAt < 0.5 then return end
			S._ESPAt = now
			feedRoles()
		end))
	end

	do
		local CHROM_SCALE, CHROM_ALPHA = 1.012, 0.025
		local CHAMS_BODY = {
			Head = true, UpperTorso = true, LowerTorso = true, Torso = true,
			LeftUpperArm = true, LeftLowerArm = true, LeftHand = true,
			RightUpperArm = true, RightLowerArm = true, RightHand = true,
			LeftUpperLeg = true, LeftLowerLeg = true, LeftFoot = true,
			RightUpperLeg = true, RightLowerLeg = true, RightFoot = true,
			["Left Arm"] = true, ["Right Arm"] = true,
			["Left Leg"] = true, ["Right Leg"] = true,
		}

		S.SelfChams = false
		S.SelfChamsType = "Highlight"

		S.SelfChamsTypes = { "Highlight", "Crystal", "Neon", "ForceField", "Chromatic" }

		local SC_MAT = {
			Crystal    = Enum.Material.Glass,
			Neon       = Enum.Material.Neon,
			ForceField = Enum.Material.ForceField,
		}
		S.SelfChamsColor = Color3.fromRGB(60, 220, 255)

		local sc_parts, sc_surfs, sc_conns = {}, {}, {}
		local sc_cache, sc_surf = {}, {}
		local sc_char, sc_valid = nil, false
		local sc_flat, sc_chrom = {}, {}
		local sc_matHl = nil
		local chrom_view, chrom_world = nil, nil

		local function chams_deformable(p)
			if p:FindFirstChildWhichIsA("WrapLayer") then return true end
			if CHAMS_BODY[p.Name] then return false end
			if p:FindFirstChildWhichIsA("Bone") then return true end
			local ok, skinned = pcall(function() return p.HasSkinnedMesh end)
			return ok and skinned == true
		end

		local function chams_shell(source, scale)
			local archivable = source.Archivable
			if not archivable then
				if not pcall(function() source.Archivable = true end) then return nil end
			end
			local ok, clone = pcall(function() return source:Clone() end)
			if not archivable then
				pcall(function() source.Archivable = archivable end)
			end
			if not ok or not clone then return nil end
			for _, child in ipairs(clone:GetChildren()) do
				if not child:IsA("DataModelMesh") then child:Destroy() end
			end
			local mesh = clone:FindFirstChildWhichIsA("DataModelMesh")
			if mesh then
				pcall(function() mesh.Scale = mesh.Scale * scale end)
				pcall(function() mesh.TextureId = "" end)
			else
				clone.Size = clone.Size * scale
			end
			pcall(function() clone.TextureID = "" end)
			pcall(function() clone.MaterialVariant = "" end)
			clone.CanCollide = false
			clone.CanQuery = false
			clone.CanTouch = false
			clone.CastShadow = false
			clone.Massless = true
			return clone
		end

		local function chrom_ensure()
			if chrom_world and chrom_world.Parent then return end
			local host = Instance.new("ScreenGui")
			host.Name = tostring(math.random(1e6, 9e6))
			host.ResetOnSpawn = false
			host.IgnoreGuiInset = true
			host.DisplayOrder = 100
			pcall(function() host.Parent = (gethui and gethui()) or game:GetService("CoreGui") end)
			chrom_view = Instance.new("ViewportFrame")
			chrom_view.Size = UDim2.fromScale(1, 1)
			chrom_view.BackgroundTransparency = 1
			chrom_view.BorderSizePixel = 0
			chrom_view.Ambient = Color3.new(1, 1, 1)
			chrom_view.LightColor = Color3.new(1, 1, 1)
			chrom_view.LightDirection = Vector3.new(-1, -1, -1)
			chrom_view.CurrentCamera = workspace.CurrentCamera
			chrom_view.Parent = host
			local sky = game:GetService("Lighting"):FindFirstChildOfClass("Sky")
			if sky then pcall(function() sky:Clone().Parent = chrom_view end) end
			chrom_world = Instance.new("WorldModel")
			chrom_world.Parent = chrom_view
		end

		local function flat_clear(state)
			if state.model then pcall(function() state.model:Destroy() end) end
			if state.occ then pcall(function() state.occ:Destroy() end) end
			if state.los then
				for i = 1, #state.los do pcall(function() state.los[i]:Destroy() end) end
			end
			state.model, state.occ, state.los, state.count, state.key = nil, nil, nil, nil, nil
		end

		local function flat_apply(state, parts, roots, col)
			local key = roots[1]
			if state.key ~= key or state.count ~= #parts or not state.model or not state.model.Parent then
				flat_clear(state)
				local model = Instance.new("Model")
				model.Name = "\0"
				for i = 1, #parts do
					local source = parts[i]
					local clone = not chams_deformable(source) and chams_shell(source, 0.99) or nil
					if clone then
						clone.Anchored = false
						clone.CFrame = source.CFrame
						clone.Parent = model
						local weld = Instance.new("WeldConstraint")
						weld.Part0 = clone
						weld.Part1 = source
						weld.Parent = clone
					end
				end
				model.Parent = workspace
				local occ = Instance.new("Highlight")
				occ.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				occ.OutlineTransparency = 1
				occ.Adornee = model
				occ.Parent = model
				local los = {}
				for i = 1, #roots do
					local hl = Instance.new("Highlight")
					hl.DepthMode = Enum.HighlightDepthMode.Occluded
					hl.OutlineTransparency = 1
					hl.Adornee = roots[i]
					hl.Parent = model
					los[i] = hl
				end
				state.model, state.occ, state.los = model, occ, los
				state.count, state.key = #parts, key
			end
			state.occ.FillColor = col
			state.occ.FillTransparency = 0
			for i = 1, #state.los do
				state.los[i].FillColor = col
				state.los[i].FillTransparency = 0
			end
		end

		local function chrom_clear(state)
			if state.model then pcall(function() state.model:Destroy() end) end
			state.model, state.entries, state.count, state.key, state.col = nil, nil, nil, nil, nil
		end

		local function chrom_apply(state, parts, key, col)
			if state.key ~= key or state.count ~= #parts or not state.model or not state.model.Parent then
				chrom_clear(state)
				chrom_ensure()
				local model = Instance.new("Model")
				model.Name = "\0"
				local entries = {}
				for i = 1, #parts do
					local source = parts[i]
					local clone = not chams_deformable(source) and chams_shell(source, CHROM_SCALE) or nil
					if clone then
						clone.Anchored = true
						clone.Material = Enum.Material.Foil
						clone.Reflectance = 0.12
						clone.Transparency = CHROM_ALPHA
						clone.Color = col
						clone.CFrame = source.CFrame
						clone.Parent = model
						entries[#entries + 1] = { source, clone }
					end
				end
				model.Parent = chrom_world
				state.model, state.entries = model, entries
				state.count, state.key, state.col = #parts, key, col
			elseif state.col ~= col then
				state.col = col
				local entries = state.entries
				if entries then
					for i = 1, #entries do
						entries[i][2].Color = col
					end
				end
			end
		end

		local function chrom_sync(state)
			local entries = state.entries
			if not entries then return end
			for i = 1, #entries do
				local source, clone = entries[i][1], entries[i][2]
				if source.Parent then
					clone.CFrame = source.CFrame
					local hidden = math.max(source.Transparency, source.LocalTransparencyModifier) >= 1
					local target_trans = hidden and 1 or CHROM_ALPHA
					if clone.Transparency ~= target_trans then
						clone.Transparency = target_trans
					end
				elseif clone.Transparency ~= 1 then
					clone.Transparency = 1
				end
			end
		end

		local function sc_restore()
			for part, d in pairs(sc_cache) do
				if part and part.Parent then
					part.Material = d[1]
					part.Color = d[2]
					if d[3] then part.Reflectance = d[3] end
					if d[4] then part.Transparency = d[4] end
				end
			end
			sc_cache = {}
			for sa, par in pairs(sc_surf) do
				if sa then pcall(function() sa.Parent = par end) end
			end
			sc_surf = {}
			sc_valid = false
		end

		local function sc_parts_for(char)
			if sc_char ~= char then
				sc_char = char
				sc_valid = false
				for i = 1, #sc_conns do
					pcall(function() sc_conns[i]:Disconnect() end)
				end
				table.clear(sc_conns)
				local function dirty() sc_valid = false end
				sc_conns[1] = char.DescendantAdded:Connect(dirty)
				sc_conns[2] = char.DescendantRemoving:Connect(dirty)
			end
			if not sc_valid then
				table.clear(sc_parts)
				table.clear(sc_surfs)
				local n, s = 0, 0
				for _, p in ipairs(char:GetDescendants()) do
					if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
						n = n + 1
						sc_parts[n] = p
					elseif p:IsA("SurfaceAppearance") then
						s = s + 1
						sc_surfs[s] = p
					end
				end
				sc_valid = true
			end
			return sc_parts
		end

		local function surfs_detach(list, store)
			for i = 1, #list do
				local sa = list[i]
				if sa.Parent and not store[sa] then
					store[sa] = sa.Parent
					pcall(function() sa.Parent = nil end)
				end
			end
		end

		local function mat_clear()
			if sc_matHl then pcall(function() sc_matHl:Destroy() end) end
			sc_matHl = nil
		end

		local function mat_apply(char, col)
			if not (sc_matHl and sc_matHl.Parent) then
				mat_clear()
				sc_matHl = Instance.new("Highlight")
				sc_matHl.Name = "NL_SelfMatCham"
				sc_matHl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				sc_matHl.FillColor, sc_matHl.OutlineColor = col, S._ChamEdge(col)
				sc_matHl.FillTransparency, sc_matHl.OutlineTransparency = 0.55, 0
				sc_matHl.Adornee = char
				sc_matHl.Parent = char
			else
				sc_matHl.FillColor, sc_matHl.OutlineColor = col, S._ChamEdge(col)
			end
		end

		local function sc_apply()
			local char = LP.Character
			if not char then return end
			local parts = sc_parts_for(char)
			local col = S.SelfChamsColor
			local style = S.SelfChamsType
			if style == "Highlight" then
				mat_clear()
				chrom_clear(sc_chrom)
				if next(sc_cache) or next(sc_surf) then sc_restore() end
				flat_apply(sc_flat, parts, { char }, col)
			elseif style == "Chromatic" then
				mat_clear()
				flat_clear(sc_flat)
				if next(sc_cache) or next(sc_surf) then sc_restore() end
				chrom_apply(sc_chrom, parts, char, col)
			else
				mat_clear()
				flat_clear(sc_flat)
				chrom_clear(sc_chrom)
				surfs_detach(sc_surfs, sc_surf)
				local mat = SC_MAT[style] or Enum.Material.ForceField
				for i = 1, #parts do
					local p = parts[i]
					if p.Parent then
						if not sc_cache[p] then
							sc_cache[p] = { p.Material, p.Color, p.Reflectance, p.Transparency }
						end
						if S._ChamDress then S._ChamDress(p, mat, col) else
							p.Material = mat
							p.Color = col
						end
					end
				end
				mat_apply(char, col)
			end
		end

		S._ClearSelfChams = function()
			mat_clear()
			flat_clear(sc_flat)
			chrom_clear(sc_chrom)
			sc_restore()
			if chrom_view then
				pcall(function() chrom_view.Parent:Destroy() end)
				chrom_view, chrom_world = nil, nil
			end
		end

		tc(RunService.Heartbeat:Connect(function()
			if S.SelfChams then sc_apply() end
		end))

		tc(RunService.RenderStepped:Connect(function()
			if not chrom_world then return end
			local cam = workspace.CurrentCamera
			if chrom_view and chrom_view.CurrentCamera ~= cam then chrom_view.CurrentCamera = cam end
			if S.SelfChams and S.SelfChamsType == "Chromatic" then chrom_sync(sc_chrom) end
		end))

		tc(LP.CharacterAdded:Connect(function()
			sc_char, sc_valid = nil, false
			table.clear(sc_cache)
			table.clear(sc_surf)
			mat_clear()
			flat_clear(sc_flat)
			chrom_clear(sc_chrom)
		end))
	end

