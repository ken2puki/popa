		local animIdCache = {}

		local function resolveAnimId(id)
			local key = tostring(id)
			if animIdCache[key] then return animIdCache[key] end
			local raw = key:gsub("%D", "")
			if raw == "" then return nil end
			local found
			local ok, objs = pcall(game.GetObjects, game, "rbxassetid://" .. raw)
			if ok and type(objs) == "table" then
				local function scan(inst)
					if found then return end
					if inst:IsA("Animation") and inst.AnimationId ~= "" then
						found = inst.AnimationId
						return
					end
					for _, c in ipairs(inst:GetChildren()) do scan(c) end
				end
				for _, o in ipairs(objs) do
					scan(o)
					pcall(function() o:Destroy() end)
				end
			end
			found = found or ("rbxassetid://" .. raw)
			animIdCache[key] = found
			return found
		end

		S.PlayEmote = function(id)
			local c = LP.Character
			local hum = c and c:FindFirstChildOfClass("Humanoid")
			if not hum then return false end
			S.ResetEmote()

			local aid = resolveAnimId(id)
			if not aid then return false end

			local a = Instance.new("Animation")
			a.AnimationId = aid
			local ok, track = pcall(function() return hum:LoadAnimation(a) end)
			a:Destroy()
			if not ok or not track then return false end

			track.Priority = Enum.AnimationPriority.Action
			track.Looped = S.EmoteLoop == true
			pcall(function() track:Play(0.1) end)
			S._currentEmoteTrack = track
			return true
		end

		S._SetEmoteLoop = function(v)
			S.EmoteLoop = v
			if not v then S.ResetEmote() end
		end

		tc(RunService.Heartbeat:Connect(function()
			local tr = S._currentEmoteTrack
			if not tr then return end
			if not S.EmoteLoop then
				if tr.Looped then pcall(function() tr.Looped = false end) end
				return
			end
			if not tr.IsPlaying then
				pcall(function() tr:Play(0.1, 1, 1) end)
			end
		end))
