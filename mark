	local SND_DIRS = { "shitaroebet/", "assets/", "khen_juju/assets/", "khen_juju/custom/", SND_USER_DIR, "", SND_CACHE_DIR }
	local SND_EXTS = { ".ogg", ".mp3", ".wav", "" }
