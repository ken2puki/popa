					return body ~= "" and game:GetService("HttpService"):JSONDecode(body) or nil
				end)
				if ok and type(res) == "table" then
					local list = res.data or res
					for _, item in pairs(list) do
						if item and item.id and item.bundledItems then fresh[#fresh + 1] = item end
					end
				end
			end
			if #fresh == 0 then return end

			S.PackCatalog = {}
			packByName = {}
			ingest(fresh)
			table.sort(S.PackCatalog, function(a, b) return a.name < b.name end)
			pcall(function()
				if not isfolder("SaladAssets") then makefolder("SaladAssets") end
				writefile(PACK_CACHE, game:GetService("HttpService"):JSONEncode(fresh))
			end)
			S._RefreshPackList()
			if S._BuildPackGrid then pcall(S._BuildPackGrid) end
		end)

		S.ResetEmote = function()
