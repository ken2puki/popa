	local function bakeOneCharacterMesh(model,def)
	    local partName=BODY_PART_TO_NAME[def.BodyPart]
	    if not partName then return false end

	    local part=model:FindFirstChild(partName,true)
	    if not part or not part:IsA("BasePart") then return false end

	    local meshId=assetIdString(def.MeshId)
	    if meshId=="" then return false end

	    for _,child in ipairs(part:GetChildren()) do
	        if child:IsA("SpecialMesh") and child.Name~="__V18_CHARACTER_MESH__" then
	            local existing=tostring(child.MeshId or "")
	            if child.MeshType==Enum.MeshType.FileMesh and existing~="" then
	                return false
	            end
	        end
	    end

	    local mesh=Instance.new("SpecialMesh")
	    mesh.Name="__V18_CHARACTER_MESH__"
	    mesh.MeshType=Enum.MeshType.FileMesh
	    mesh.MeshId=meshId

	    local base=assetIdString(def.BaseTextureId)
	    local overlay=assetIdString(def.OverlayTextureId)

	    if base~="" then
	        mesh.TextureId=base
	    elseif overlay~="" then
	        mesh.TextureId=overlay
	    end

	    mesh.Scale=Vector3.new(1,1,1)
	    mesh.Offset=Vector3.zero
	    mesh.Parent=part
	    return true
	end

	local function bakeExactCharacterMeshes(model,data)
	    clearBakedBodyMeshes(model)

	    local defs=collectDumpCharacterMeshDefs(model)

	    if #defs==0 then
	        defs=GAME_CHARACTER_MESHES[tostring(data.name or "")] or {}
	    end

	    clearCharacterMeshes(model)

	    local applied=0
	    for _,def in ipairs(defs) do
	        if bakeOneCharacterMesh(model,def) then
	            applied+=1
	        end
	    end
	    return applied
	end

	local function repairCharacterMeshes(visualModel,data)
	    if bodyMeshMode=="OFF" then
	        clearCharacterMeshes(visualModel)
	        clearBakedBodyMeshes(visualModel)
	        return "OFF"
	    end

	    local count=bakeExactCharacterMeshes(visualModel,data)
	    if count>0 then
	        return "BAKED EXACT x"..tostring(count)
	    end

	    clearCharacterMeshes(visualModel)
	    clearBakedBodyMeshes(visualModel)
	    return "PLAIN R6 (NO EXACT BODY MESH)"
	end

