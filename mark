		local observed, fired = {}, setmetatable({}, { __mode = "k" });

		local function onDeath(char, hum)
			if not char or fired[char] then return end;
			fired[char] = true;
			if not S.KillSound then return end;
			local myRole = getRole(LP);
			local sheriffSide = (myRole == "Sheriff" or myRole == "Hero");
			if S._PlayKillSound then
				pcall(S._PlayKillSound, sheriffSide and S.KillSoundSheriff or S.KillSoundMurder);
			end;
		end;

		S._KillObsAt = 0;
		tc(RunService.Heartbeat:Connect(function()
			if not S.KillSound then
				if next(observed) then table.clear(observed) end;
				return;
			end;
			local now = os.clock();
			if now - S._KillObsAt < 0.1 then return end;
			S._KillObsAt = now;

			for _, pl in ipairs(Players:GetPlayers()) do
				if pl ~= LP then
					local ch = pl.Character;
					local hum = ch and ch:FindFirstChildOfClass("Humanoid");
					local alive = hum ~= nil and hum.Health > 0;
					local st = observed[pl];
