			-- moving the toggle runs its callback, so the feature still applies
			-- and the row stops showing the value the bind just changed.
			-- Only the FIRST bind on a gear is that row's on/off switch; the
			-- ones after it (prediction, kill all) do their own thing and must
			-- keep the function they were handed.
			local row = gear and gear.__row;
			local tgl = row and row.__toggle;
			local primary = tgl ~= nil and not (row and row.__bound);
			if primary then
				row.__bound = true;
				apply = function() tgl:SetValue(not tgl:GetValue()) end;
				-- the HUD switch reads this to show the real state
				S.BindToggles = S.BindToggles or {};
				S.BindToggles[name] = tgl;
			end;

			local function register(k)
				if k == nil then
					S.Binds[name] = nil
					return
				end
				if k == "M1B" or k == "MouseButton1" then
					S.Binds[name] = { mouse = Enum.UserInputType.MouseButton1, apply = apply }
					return
				end
				if k == "M2B" or k == "MouseButton2" then
					S.Binds[name] = { mouse = Enum.UserInputType.MouseButton2, apply = apply }
					return
				end
				local ok, kc = pcall(function() return Enum.KeyCode[k] end)
				if ok and kc then
					S.Binds[name] = { key = kc, apply = apply }
				else
					S.Binds[name] = nil
				end
			end
			-- a gear can hold two binds; "Bind" twice tells you nothing
			gear:AddLabel(primary and "Bind" or (name .. " Bind")):AddKeybind({
				Default = default,
				Callback = function(k)
					register(k)
				end,
			})
			register(default)
		end

