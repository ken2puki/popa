	S.Backtrack        = false;
	S.BacktrackStyle   = "Highlight";
	S.BacktrackColor   = Color3.fromRGB(60, 220, 255);
	S.BacktrackTarget  = "Others";
	S.BacktrackDepth   = 0;
	S.BacktrackOpacity = 65;
	S.BacktrackTargets = { "Others", "Me", "All" };

	do
		local STYLE = {
			Highlight  = { material = Enum.Material.ForceField, alpha = 0.35, outline = true },
			Crystal    = { material = Enum.Material.Glass,      alpha = 0.40, outline = true },
			Neon       = { material = Enum.Material.Neon,       alpha = 0.45, outline = false },
			ForceField = { material = Enum.Material.ForceField, alpha = 0.25, outline = false },
			Chromatic  = { material = Enum.Material.Glass,      alpha = 0.15, outline = true, chroma = true },
		};
		local ghosts = setmetatable({}, { __mode = "k" });

		local hist = setmetatable({}, { __mode = "k" });
		local HIST_MAX = 2.0;
		local sampleAt = 0;

		local function record(now)
			if now - sampleAt < 1/30 then return end;
			sampleAt = now;
			for _, p in ipairs(Players:GetPlayers()) do
				local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart");
				if hrp then
					local h = hist[p];
					if not h then h = {}; hist[p] = h end;
					h[#h + 1] = { t = now, cf = hrp.CFrame };

					if #h > 70 then
						local keep = {};
						for i = #h - 59, #h do keep[#keep + 1] = h[i] end;
						hist[p] = keep;
					end;
				end;
			end;
		end;

		local function lookup(p, now, depth)
			local h = hist[p];
			if not h or #h == 0 then return nil end;
			local want = now - depth;

			-- newer than anything recorded: the most recent sample is the best
			-- answer available
			if want >= h[#h].t then return h[#h].cf end;

			for i = #h, 1, -1 do
				if h[i].t <= want then
					local a = h[i];
					local b = h[i + 1];
					if not b then return a.cf end;
					local span = b.t - a.t;
					if span <= 0 then return a.cf end;
					-- samples land 33ms apart; returning the older one whole
					-- puts the ghost up to a third of a frame behind and makes
					-- it hop between samples instead of travelling
					return a.cf:Lerp(b.cf, math.clamp((want - a.t) / span, 0, 1));
				end;
			end;

			return h[1].cf;
		end;
		S._BacktrackHistory = function(p) return hist[p] and #hist[p] or 0 end;

		local function clearGhost(p)
			local g = ghosts[p];
