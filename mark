-- ========== НАСТРОЙКИ ==========
local TEXT       = "АРТЕМ СОСУНЕЦ)))"       -- что вывести
local DURATION   = 500                        -- сколько секунд мигать
local FLASH_RATE = 0.08                     -- частота мигания (чем меньше — тем быстрее)
local TEXT_COLOR = Color3.fromRGB(255, 0, 0) -- цвет текста
local TEXT_SIZE  = 60                       -- размер текста
-- ================================

local Players = game:GetService("Players")
local LP = Players.LocalPlayer
local CoreGui = (gethui and gethui()) or game:GetService("CoreGui")

-- защита GUI (если поддерживается)
local protect = protect_gui or protectgui or syn and syn.protect_gui or function(x) return x end

-- создаём ScreenGui
local gui = Instance.new("ScreenGui")
gui.Name = "FlashEffect_" .. math.random(1, 1e9)
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 999999
protect(gui)
gui.Parent = CoreGui

-- фоновый фрейм (мигает)
local bg = Instance.new("Frame")
bg.Size = UDim2.fromScale(1, 1)
bg.Position = UDim2.fromScale(0, 0)
bg.BackgroundColor3 = Color3.new(0, 0, 0)
bg.BorderSizePixel = 0
bg.ZIndex = 1
bg.Parent = gui

-- текст
local label = Instance.new("TextLabel")
label.Size = UDim2.fromScale(1, 1)
label.Position = UDim2.fromScale(0, 0)
label.BackgroundTransparency = 1
label.Text = TEXT
label.TextColor3 = TEXT_COLOR
label.TextSize = TEXT_SIZE
label.Font = Enum.Font.GothamBold
label.TextScaled = false
label.ZIndex = 2
label.Parent = gui

-- обводка текста для читаемости
local stroke = Instance.new("UIStroke")
stroke.Color = Color3.new(0, 0, 0)
stroke.Thickness = 3
stroke.Parent = label

-- мигание
local startTime = tick()
local flash = true

task.spawn(function()
    while tick() - startTime < DURATION do
        flash = not flash
        bg.BackgroundColor3 = flash and Color3.new(1, 1, 1) or Color3.new(0, 0, 0)
        label.TextColor3 = flash and Color3.new(0, 0, 0) or TEXT_COLOR
        task.wait(FLASH_RATE)
    end
    -- убираем
    gui:Destroy()
end)
