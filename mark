	local function buildAnimatedVisualSolver(model)
	    local joints={}
	    local constraints={}

	    for _,x in ipairs(model:GetDescendants()) do
	        if (x:IsA("Motor6D") or x:IsA("Weld") or x:IsA("ManualWeld") or x:IsA("Snap"))
	            and x.Part0 and x.Part1 then
	            joints[#joints+1]=x

	        elseif x:IsA("WeldConstraint") and x.Part0 and x.Part1 then
	            constraints[#constraints+1]={
	                p0=x.Part0,
	                p1=x.Part1,
	                rel01=x.Part0.CFrame:ToObjectSpace(x.Part1.CFrame),
	            }
	        end
	    end

	    local bodyAtt={}
	    for _,x in ipairs(model:GetDescendants()) do
	        if x:IsA("Attachment") and x.Parent and x.Parent:IsA("BasePart") then
	            local owner=x.Parent
	            local isHandle=owner.Name=="Handle" and owner.Parent
	                and (owner.Parent:IsA("Accessory") or owner.Parent:IsA("Hat"))
	            if not isHandle and not bodyAtt[x.Name] then
	                bodyAtt[x.Name]={part=owner,att=x}
	            end
	        end
	    end

	    local hangers={}
	    for _,acc in ipairs(model:GetDescendants()) do
	        if acc:IsA("Accessory") or acc:IsA("Hat") then
	            local handle=acc:FindFirstChild("Handle")
	            if handle and handle:IsA("BasePart") then
	                for _,a in ipairs(handle:GetChildren()) do
	                    if a:IsA("Attachment") and bodyAtt[a.Name] then
	                        local anchorPoint=bodyAtt[a.Name]
	                        hangers[#hangers+1]={
	                            handle=handle,
	                            part=anchorPoint.part,
	                            rel=anchorPoint.part.CFrame:ToObjectSpace(handle.CFrame),
	                        }
	                        break
	                    end
	                end
	            end
	        end
	    end

	    local riders={}
	    for _,h in ipairs(hangers) do
	        for _,x in ipairs(h.handle.Parent:GetDescendants()) do
	            if x:IsA("BasePart") and x~=h.handle then
	                riders[#riders+1]={
	                    part=x,
	                    anchor=h.handle,
	                    rel=h.handle.CFrame:ToObjectSpace(x.CFrame),
	                }
	            end
	        end
	    end

	    local root=model.PrimaryPart
	        or model:FindFirstChild("HumanoidRootPart",true)
	        or model:FindFirstChild("Torso",true)
	        or model:FindFirstChild("UpperTorso",true)
	        or model:FindFirstChildWhichIsA("BasePart",true)

	    assert(root and root:IsA("BasePart"),"visual skin has no usable root")

	    local sourceRootCF=root.CFrame
	    local fallback={}
	    for _,part in ipairs(model:GetDescendants()) do
	        if part:IsA("BasePart") and part~=root then
	            fallback[part]=sourceRootCF:ToObjectSpace(part.CFrame)
	        end
	    end

	    return root,function(rootCF)
	        if not root.Parent then return end
	        root.CFrame=rootCF

	        local solved={[root]=true}

	        for _=1,48 do
	            local changed=false

	            for _,j in ipairs(joints) do
	                local p0,p1=j.Part0,j.Part1
	                if p0 and p1 and p0.Parent and p1.Parent then
	                    local transform=CFrame.new()
	                    if j:IsA("Motor6D") then
	                        transform=j.Transform
	                    end

	                    if solved[p0] and not solved[p1] then
	                        p1.CFrame=p0.CFrame*j.C0*transform*j.C1:Inverse()
	                        solved[p1]=true
	                        changed=true
	                    elseif solved[p1] and not solved[p0] then
	                        p0.CFrame=p1.CFrame*j.C1*transform:Inverse()*j.C0:Inverse()
	                        solved[p0]=true
	                        changed=true
	                    end
	                end
	            end

	            for _,w in ipairs(constraints) do
	                local p0,p1=w.p0,w.p1
	                if p0 and p1 and p0.Parent and p1.Parent then
	                    if solved[p0] and not solved[p1] then
	                        p1.CFrame=p0.CFrame*w.rel01
	                        solved[p1]=true
	                        changed=true
	                    elseif solved[p1] and not solved[p0] then
	                        p0.CFrame=p1.CFrame*w.rel01:Inverse()
	                        solved[p0]=true
	                        changed=true
	                    end
	                end
	            end

	            for _,h in ipairs(hangers) do
	                if h.handle.Parent and h.part.Parent
	                    and solved[h.part] and not solved[h.handle] then
	                    h.handle.CFrame=h.part.CFrame*h.rel
	                    solved[h.handle]=true
	                    changed=true
	                end
	            end

	            for _,r in ipairs(riders) do
	                if r.part.Parent and r.anchor.Parent
	                    and solved[r.anchor] and not solved[r.part] then
	                    r.part.CFrame=r.anchor.CFrame*r.rel
	                    solved[r.part]=true
	                    changed=true
	                end
	            end

	            if not changed then break end
	        end

	        for part,off in pairs(fallback) do
	            if part.Parent and not solved[part] then
	                part.CFrame=rootCF*off
	            end
	        end
	    end
	end

