	function Window:ToggleInterface()
		Window.Signal:SetValue(not Window.Signal:GetValue());

		if not Window.Signal:GetValue() then
			for _, pb in ipairs(NeverLose.OptionWindows or {}) do
				pcall(function()
					if pb.Signal and pb.Signal:GetValue() then
						pb.Signal:SetValue(false);
					end;
					if pb.Root and pb.Root.Parent then
						pb.Root.BackgroundTransparency = 1;
					end;
				end);
			end;

			if NeverLose.ScreenGui then
				for _, obj in ipairs(NeverLose.ScreenGui:GetChildren()) do
					pcall(function()
						if obj:IsA("Frame")
							and not (NeverLose.FloatKeep and NeverLose.FloatKeep[obj])
							and obj.BackgroundTransparency < 0.95 then
