	            joints+=1
	        end
	    end

	    print("[UniversalSkin V18] applied:",name,
	        "objects:",#(data.objects or {}),
	        "visibleParts:",visibleParts,
	        "accessories:",accessories,
	        "bakedBodyMeshes:",bakedBodyMeshes,
	        "joints:",joints,
	        "scale:",string.format("%.4f",scaleFactor),
	        "shirt:",hasShirt,
	        "pants:",hasPants,
	        "graphic:",hasGraphic,
	        "mesh:",meshStatus,
	        "rig:",data.rigType)

