		end;

		local function silence(sound)
			if saved[sound] == nil then saved[sound] = sound.Volume end;
			if sound.Volume ~= 0 then pcall(function() sound.Volume = 0 end) end;
		end;

		local function restore(sound)
			local vol = saved[sound];
			if vol == nil then return end;
			saved[sound] = nil;
			if sound.Parent then pcall(function() sound.Volume = vol end) end;
		end;

		local function apply(sound)
			if not (sound and sound.Parent and sound:IsA("Sound")) then return end;
			if S.Mute and wanted(sound) then silence(sound) else restore(sound) end;
		end;

		local function track(sound)
			if not sound:IsA("Sound") or known[sound] then return end;
			known[sound] = true;

			apply(sound);
			tc(sound.Played:Connect(function() apply(sound) end));
			tc(sound:GetPropertyChangedSignal("Playing"):Connect(function() apply(sound) end));
			tc(sound:GetPropertyChangedSignal("Parent"):Connect(function() apply(sound) end));
		end;

		for _, d in ipairs(game:GetDescendants()) do
			if d:IsA("Sound") then track(d) end;
		end;
		tc(game.DescendantAdded:Connect(function(d)
			if d:IsA("Sound") then track(d) end;
		end));

