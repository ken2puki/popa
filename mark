		local function strew()
			for i = 1, #map_rows do
				local row = map_rows[i]
				local t = tiles[row.name]
				if not t then
					t = hatch(row)
					tiles[row.name] = t
				end
				if row.image ~= "" and t.img.Image ~= row.image then
					t.img.Image = row.image

					local want = row.image
					task.spawn(function()
						local stop = os.clock() + 6
						while os.clock() < stop do
							if t.img.Image ~= want then return end
							if t.img.IsLoaded then return end
							task.wait(0.25)
						end
						if t.img.Image ~= want then return end
						t.img.Image = ""
						t.blank.Visible = true
						map_defs[row.name] = ""
						row.image = ""
					end)
				end
				t.blank.Visible = row.image == ""
				t.card.LayoutOrder = i
				paint(t)
			end
			empty.Visible = #map_rows == 0
		end

		local CACHE = "SaladAssets/maps.json"

		local function sort_rows()
			table.sort(map_rows, function(a, b)
				return string.lower(a.name) < string.lower(b.name)
			end)
		end

		local function learn(name, image)
			if type(name) ~= "string" or name == "" or name == "MAP NAME" then return false end
			image = (type(image) == "string" and image) or ""
			local known = map_defs[name]
			if known == nil then
				map_defs[name] = image
				map_rows[#map_rows + 1] = { name = name, label = name, image = image }
				return true
			end
			if known == "" and image ~= "" then
				map_defs[name] = image
				for i = 1, #map_rows do
					if map_rows[i].name == name then map_rows[i].image = image break end
				end
				return true
			end
			return false
		end

		local function save()
			pcall(function()
				if not (isfolder and makefolder and writefile) then return end
				if not isfolder("SaladAssets") then makefolder("SaladAssets") end
				map_defs.seen, map_defs.icons = nil, nil
				writefile(CACHE, HttpService:JSONEncode(map_defs))
			end)
		end

		local JUNK = { seen = true, icons = true }

		local DUD = { ["rbxassetid://3214478462"] = true }

		local function swallow(d)
			if type(d) ~= "table" then return false end
			local grew = false
			local src = (type(d.icons) == "table") and d.icons or d
			for name, image in pairs(src) do
				if type(name) == "string" and type(image) == "string" and not JUNK[name] then
					if DUD[image] then image = "" end
					if learn(name, image) then grew = true end
				end
			end
			return grew
		end

